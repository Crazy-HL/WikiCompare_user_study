{"ast":null,"code":"import { computed, ref, onMounted, watch, nextTick } from \"vue\";\nimport * as d3 from \"d3\";\nexport default {\n  props: {\n    field: [Object, Array, String, Number],\n    type: String,\n    visualization: String,\n    fieldKey: String,\n    unifiedMax: Number,\n    categoryColors: {\n      type: Object,\n      default: () => ({})\n    }\n  },\n  emits: [\"chartClick\"],\n  setup(props, _ref) {\n    let {\n      emit\n    } = _ref;\n    const hoveredIndex = ref(null);\n    const activeIndex = ref(null);\n    const isTextHovered = ref(false);\n    const pieContainer = ref(null);\n    const barContainer = ref(null);\n    const lineContainer = ref(null);\n    const stackedContainer = ref(null);\n    const colors = [\"#2E86DE\", \"#E74C3C\", \"#27AE60\", \"#F1C40F\", \"#8E44AD\"];\n    const remainderColor = \"#ECF0F1\";\n\n    // ========== 工具函数 ==========\n    const safeToNumber = val => {\n      if (val == null) return 0;\n      if (typeof val === \"number\") return val;\n      const s = String(val);\n      if (s.includes(\"亿\")) return parseFloat(s) * 1e8;\n      if (s.includes(\"万\")) return parseFloat(s) * 1e4;\n      return parseFloat(s) || 0;\n    };\n    const processedField = computed(() => {\n      if (!props.field) return [];\n      const arr = Array.isArray(props.field) ? props.field : [props.field];\n      return arr.map(f => ({\n        raw: f.raw ?? f.value ?? f,\n        value: safeToNumber(f.value ?? f.raw ?? f),\n        label: f.label ?? f.raw ?? f\n      })).filter(f => f.raw != null && String(f.raw).trim() !== \"\");\n    });\n    const hasData = computed(() => processedField.value.length > 0);\n\n    // ========== 渲染饼图 ==========\n    const renderPieChart = () => {\n      if (!pieContainer.value) return;\n      d3.select(pieContainer.value).selectAll(\"*\").remove();\n      const width = pieContainer.value.clientWidth;\n      const height = pieContainer.value.clientHeight;\n      const radius = Math.min(width, height) / 2 - 10;\n      const svg = d3.select(pieContainer.value).append(\"svg\").attr(\"width\", width).attr(\"height\", height).append(\"g\").attr(\"transform\", `translate(${width / 2},${height / 2})`);\n      const pie = d3.pie().value(d => d.value);\n      const arc = d3.arc().innerRadius(0).outerRadius(radius);\n      const data = processedField.value.map((d, i) => ({\n        name: d.label,\n        value: d.value,\n        color: colors[i % colors.length]\n      }));\n      const tooltip = d3.select(pieContainer.value).append(\"div\").attr(\"class\", \"d3-tooltip\").style(\"position\", \"absolute\").style(\"visibility\", \"hidden\");\n      const arcs = svg.selectAll(\"arc\").data(pie(data)).enter().append(\"g\");\n      arcs.append(\"path\").attr(\"d\", arc).attr(\"fill\", d => d.data.color).style(\"opacity\", 0.9).on(\"mouseover\", (e, d) => {\n        tooltip.html(`${d.data.name}: ${d.data.value}`).style(\"visibility\", \"visible\");\n        d3.select(e.currentTarget).transition().duration(200).style(\"opacity\", 1);\n      }).on(\"mousemove\", e => {\n        tooltip.style(\"top\", e.offsetY + 20 + \"px\").style(\"left\", e.offsetX + 20 + \"px\");\n      }).on(\"mouseout\", e => {\n        tooltip.style(\"visibility\", \"hidden\");\n        d3.select(e.currentTarget).transition().duration(200).style(\"opacity\", 0.9);\n      });\n      arcs.append(\"text\").attr(\"transform\", d => `translate(${arc.centroid(d)})`).attr(\"text-anchor\", \"middle\").style(\"font-size\", \"13px\").style(\"fill\", \"#222\").text(d => `${d.data.name}`);\n    };\n\n    // ========== 渲染柱状图 ==========\n    const renderBarChart = () => {\n      if (!barContainer.value) return;\n      d3.select(barContainer.value).selectAll(\"*\").remove();\n      const width = barContainer.value.clientWidth;\n      const height = barContainer.value.clientHeight;\n      const svg = d3.select(barContainer.value).append(\"svg\").attr(\"width\", width).attr(\"height\", height);\n      const data = processedField.value.map((d, i) => ({\n        value: d.value,\n        label: d.label,\n        color: colors[i % colors.length]\n      }));\n      const x = d3.scaleBand().domain(data.map(d => d.label)).range([50, width - 20]).padding(0.3);\n      const y = d3.scaleLinear().domain([0, d3.max(data, d => d.value) * 1.2]).range([height - 40, 10]);\n      svg.selectAll(\"rect\").data(data).enter().append(\"rect\").attr(\"x\", d => x(d.label)).attr(\"y\", d => y(d.value)).attr(\"width\", x.bandwidth()).attr(\"height\", d => height - 40 - y(d.value)).attr(\"fill\", d => d.color).style(\"opacity\", 0.85);\n\n      // 数值标签\n      svg.selectAll(\"text.value\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.label) + x.bandwidth() / 2).attr(\"y\", d => y(d.value) - 5).attr(\"text-anchor\", \"middle\").style(\"font-size\", \"13px\").style(\"fill\", \"#111\").text(d => d.value);\n\n      // X轴标签\n      svg.selectAll(\"text.label\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.label) + x.bandwidth() / 2).attr(\"y\", height - 10).attr(\"text-anchor\", \"middle\").style(\"font-size\", \"13px\").style(\"fill\", \"#333\").text(d => d.label);\n    };\n\n    // ========== 渲染折线图 ==========\n    const renderLineChart = () => {\n      if (!lineContainer.value) return;\n      d3.select(lineContainer.value).selectAll(\"*\").remove();\n      const width = lineContainer.value.clientWidth;\n      const height = lineContainer.value.clientHeight;\n      const svg = d3.select(lineContainer.value).append(\"svg\").attr(\"width\", width).attr(\"height\", height);\n      const data = processedField.value.map((d, i) => ({\n        x: i,\n        y: d.value\n      }));\n      const x = d3.scaleLinear().domain([0, data.length - 1]).range([40, width - 20]);\n      const y = d3.scaleLinear().domain([0, d3.max(data, d => d.y) * 1.2]).range([height - 30, 10]);\n      const line = d3.line().x(d => x(d.x)).y(d => y(d.y)).curve(d3.curveMonotoneX);\n      svg.append(\"path\").datum(data).attr(\"fill\", \"none\").attr(\"stroke\", \"#2E86DE\").attr(\"stroke-width\", 2.5).attr(\"d\", line);\n      svg.selectAll(\"circle\").data(data).enter().append(\"circle\").attr(\"cx\", d => x(d.x)).attr(\"cy\", d => y(d.y)).attr(\"r\", 4).attr(\"fill\", \"#2E86DE\");\n      svg.selectAll(\"text\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.x)).attr(\"y\", d => y(d.y) - 8).attr(\"text-anchor\", \"middle\").style(\"font-size\", \"13px\").style(\"fill\", \"#111\").text(d => d.y);\n    };\n\n    // ========== 渲染堆叠图 ==========\n    const renderStackedChart = () => {\n      if (!stackedContainer.value) return;\n      d3.select(stackedContainer.value).selectAll(\"*\").remove();\n      const width = stackedContainer.value.clientWidth;\n      const height = stackedContainer.value.clientHeight;\n      const svg = d3.select(stackedContainer.value).append(\"svg\").attr(\"width\", width).attr(\"height\", height);\n      const data = processedField.value.map((d, i) => ({\n        name: d.label,\n        value: d.value,\n        color: colors[i % colors.length]\n      }));\n      let cumulative = 0;\n      const rects = data.map(d => {\n        const start = cumulative;\n        cumulative += d.value;\n        return {\n          ...d,\n          y0: start,\n          y1: cumulative\n        };\n      });\n      const total = cumulative;\n      const y = d3.scaleLinear().domain([0, total]).range([height - 20, 20]);\n      svg.selectAll(\"rect\").data(rects).enter().append(\"rect\").attr(\"x\", width / 2 - 40).attr(\"width\", 80).attr(\"y\", d => y(d.y1)).attr(\"height\", d => y(d.y0) - y(d.y1)).attr(\"fill\", d => d.color).style(\"opacity\", 0.9);\n      svg.selectAll(\"text\").data(rects).enter().append(\"text\").attr(\"x\", width / 2).attr(\"y\", d => (y(d.y0) + y(d.y1)) / 2).attr(\"text-anchor\", \"middle\").style(\"font-size\", \"13px\").style(\"fill\", \"#111\").text(d => `${d.name} (${d.value})`);\n    };\n    onMounted(() => {\n      watch(() => props.visualization, async () => {\n        await nextTick();\n        if (props.visualization === \"pie-chart\") renderPieChart();\n        if (props.visualization === \"bar-chart\") renderBarChart();\n        if (props.visualization === \"line-chart\") renderLineChart();\n        if (props.visualization === \"stacked-chart\") renderStackedChart();\n      }, {\n        immediate: true\n      });\n    });\n    return {\n      isTextHovered,\n      processedField,\n      getRawTextForRank: () => \"\",\n      handleTextHover: () => isTextHovered.value = true,\n      resetHover: () => isTextHovered.value = false,\n      handleTextClick: () => emit(\"chartClick\"),\n      hasData\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","watch","nextTick","d3","props","field","Object","Array","String","Number","type","visualization","fieldKey","unifiedMax","categoryColors","default","emits","setup","_ref","emit","hoveredIndex","activeIndex","isTextHovered","pieContainer","barContainer","lineContainer","stackedContainer","colors","remainderColor","safeToNumber","val","s","includes","parseFloat","processedField","arr","isArray","map","f","raw","value","label","filter","trim","hasData","length","renderPieChart","select","selectAll","remove","width","clientWidth","height","clientHeight","radius","Math","min","svg","append","attr","pie","d","arc","innerRadius","outerRadius","data","i","name","color","tooltip","style","arcs","enter","on","e","html","currentTarget","transition","duration","offsetY","offsetX","centroid","text","renderBarChart","x","scaleBand","domain","range","padding","y","scaleLinear","max","bandwidth","renderLineChart","line","curve","curveMonotoneX","datum","renderStackedChart","cumulative","rects","start","y0","y1","total","immediate","getRawTextForRank","handleTextHover","resetHover","handleTextClick"],"sources":["D:\\vue_frame\\vue_frame\\wikitable-vue\\client\\src\\components\\compoents_base\\SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">暂无数据</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 柱状图 -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">暂无数据</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 折线图 -->\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">暂无数据</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 堆叠图 -->\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">暂无数据</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\timport { computed, ref, onMounted, watch, nextTick } from \"vue\";\r\n\timport * as d3 from \"d3\";\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\tfield: [Object, Array, String, Number],\r\n\t\t\ttype: String,\r\n\t\t\tvisualization: String,\r\n\t\t\tfieldKey: String,\r\n\t\t\tunifiedMax: Number,\r\n\t\t\tcategoryColors: { type: Object, default: () => ({}) }\r\n\t\t},\r\n\t\temits: [\"chartClick\"],\r\n\r\n\t\tsetup(props, { emit }) {\r\n\t\t\tconst hoveredIndex = ref(null);\r\n\t\t\tconst activeIndex = ref(null);\r\n\t\t\tconst isTextHovered = ref(false);\r\n\r\n\t\t\tconst pieContainer = ref(null);\r\n\t\t\tconst barContainer = ref(null);\r\n\t\t\tconst lineContainer = ref(null);\r\n\t\t\tconst stackedContainer = ref(null);\r\n\r\n\t\t\tconst colors = [\"#2E86DE\", \"#E74C3C\", \"#27AE60\", \"#F1C40F\", \"#8E44AD\"];\r\n\t\t\tconst remainderColor = \"#ECF0F1\";\r\n\r\n\t\t\t// ========== 工具函数 ==========\r\n\t\t\tconst safeToNumber = val => {\r\n\t\t\t\tif (val == null) return 0;\r\n\t\t\t\tif (typeof val === \"number\") return val;\r\n\t\t\t\tconst s = String(val);\r\n\t\t\t\tif (s.includes(\"亿\")) return parseFloat(s) * 1e8;\r\n\t\t\t\tif (s.includes(\"万\")) return parseFloat(s) * 1e4;\r\n\t\t\t\treturn parseFloat(s) || 0;\r\n\t\t\t};\r\n\r\n\t\t\tconst processedField = computed(() => {\r\n\t\t\t\tif (!props.field) return [];\r\n\t\t\t\tconst arr = Array.isArray(props.field) ? props.field : [props.field];\r\n\t\t\t\treturn arr\r\n\t\t\t\t\t.map(f => ({\r\n\t\t\t\t\t\traw: f.raw ?? f.value ?? f,\r\n\t\t\t\t\t\tvalue: safeToNumber(f.value ?? f.raw ?? f),\r\n\t\t\t\t\t\tlabel: f.label ?? f.raw ?? f\r\n\t\t\t\t\t}))\r\n\t\t\t\t\t.filter(f => f.raw != null && String(f.raw).trim() !== \"\");\r\n\t\t\t});\r\n\r\n\t\t\tconst hasData = computed(() => processedField.value.length > 0);\r\n\r\n\t\t\t// ========== 渲染饼图 ==========\r\n\t\t\tconst renderPie