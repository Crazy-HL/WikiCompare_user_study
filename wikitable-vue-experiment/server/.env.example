# Copy this file to .env in the same directory, then fill in your provider key.
# The real .env file is ignored by git.
OPENAI_MODEL="gpt-5.5"
OPENAI_BASE_URL="https://newapi.lxhei.xyz/v1"
OPENAI_TIMEOUT_SECONDS="120"
OPENAI_API_KEY="your-provider-key"
EXPERIMENT_ADMIN_PASSWORD="change-this-before-deploy"
EXPERIMENT_DATA_DIR="./experiment_data"
