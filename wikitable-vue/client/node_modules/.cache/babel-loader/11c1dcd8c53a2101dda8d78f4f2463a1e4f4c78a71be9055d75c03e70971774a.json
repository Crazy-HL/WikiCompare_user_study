[0] = function () {\n      return _ctx.handleTextClick && _ctx.handleTextClick(...arguments);\n    }),\n    onMouseenter: _cache[1] || (_cache[1] = function () {\n      return _ctx.handleTextHover && _ctx.handleTextHover(...arguments);\n    }),\n    onMouseleave: _cache[2] || (_cache[2] = function () {\n      return _ctx.resetHover && _ctx.resetHover(...arguments);\n    })\n  }, _toDisplayString(_ctx.formatSimpleText(_ctx.processedField)), 33 /* TEXT, NEED_HYDRATION */)], 2112 /* STABLE_FRAGMENT, DEV_ROOT_FRAGMENT */)), _ctx.isTextHovered && $props.fieldKey !== 'GDP rank' ? (_openBlock(), _createElementBlock(\"div\", _hoisted_3, \" 点击查看详情 \")) : _createCommentVNode(\"v-if\", true)], 64 /* STABLE_FRAGMENT */)) : $props.visualization === 'pie-chart' ? (_openBlock(), _createElementBlock(_Fragment, {\n    key: 1\n  }, [_createCommentVNode(\" 饼图 (D3实现) \"), _createCommentVNode(\" 这个容器现在是图表和图注的父容器 \"), _ctx.hasData && _ctx.isValidPieData ? (_openBlock(), _createElementBlock(\"div\", _hoisted_4, null, 512 /* NEED_PATCH */)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_5, \"-\"))], 64 /* STABLE_FRAGMENT */)) : $props.visualization === 'bar-chart' ? (_openBlock(), _createElementBlock(_Fragment, {\n    key: 2\n  }, [_createCommentVNode(\" 其他图表... \"), _ctx.hasData ? (_openBlock(), _createElementBlock(\"div\", _hoisted_6, null, 512 /* NEED_PATCH */)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_7, \"-\"))], 64 /* STABLE_FRAGMENT */)) : $props.visualization === 'line-chart' ? (_openBlock(), _createElementBlock(_Fragment, {\n    key: 3\n  }, [_ctx.hasData ? (_openBlock(), _createElementBlock(\"div\", _hoisted_8, null, 512 /* NEED_PATCH */)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_9, \"-\"))], 64 /* STABLE_FRAGMENT */)) : $props.visualization === 'stacked-chart' ? (_openBlock(), _createElementBlock(_Fragment, {\n    key: 4\n  }, [_ctx.hasData ? (_openBlock(), _createElementBlock(\"div\", _hoisted_10, null, 512 /* NEED_PATCH */)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_11, \"-\"))], 64 /* STABLE_FRAGMENT */)) : (_openBlock(), _createElementBlock(_Fragment, {\n    key: 5\n  }, [_createCommentVNode(\" 默认显示 \"), _createElementVNode(\"div\", {\n    class: \"simple-text\",\n    onClick: _cache[3] || (_cache[3] = function () {\n      return _ctx.handleTextClick && _ctx.handleTextClick(...arguments);\n    }),\n    onMouseenter: _cache[4] || (_cache[4] = function () {\n      return _ctx.handleTextHover && _ctx.handleTextHover(...arguments);\n    }),\n    onMouseleave: _cache[5] || (_cache[5] = function () {\n      return _ctx.resetHover && _ctx.resetHover(...arguments);\n    })\n  }, _toDisplayString(_ctx.formatSimpleText(_ctx.processedField)), 33 /* TEXT, NEED_HYDRATION */), _ctx.isTextHovered ? (_openBlock(), _createElementBlock(\"div\", _hoisted_12, \"点击查看详情\")) : _createCommentVNode(\"v-if\", true)], 64 /* STABLE_FRAGMENT */))]);\n}","map":{"version":3,"names":["class","key","ref","_createElementBlock","_hoisted_1","_createCommentVNode","$props","visualization","_Fragment","fieldKey","_hoisted_2","_toDisplayString","_ctx","getRawTextForRank","processedField","_createElementVNode","onClick","_cache","handleTextClick","arguments","onMouseenter","handleTextHover","onMouseleave","resetHover","formatSimpleText","isTextHovered","_hoisted_3","hasData","isValidPieData","_hoisted_4","_hoisted_5","_hoisted_6","_hoisted_7","_hoisted_8","_hoisted_9","_hoisted_10","_hoisted_11","_hoisted_12"],"sources":["D:\\vue_frame\\vue_frame\\wikitable-vue\\client\\src\\components\\compoents_base\\SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<!-- GDP Rank 的直接显示 -->\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<!-- 其他文本字段保持原样 -->\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<!-- 这个容器现在是图表和图注的父容器 -->\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container pie-layout-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 其他图表... -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\timport { computed, ref, onMounted, watch, nextTick } from \"vue\";\r\n\timport * as d3 from \"d3\";\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\t// ... props 保持不变\r\n\t\t\tfield: {\r\n\t\t\t\ttype: [Object, Array, String, Number],\r\n\t\t\t\tdefault: null\r\n\t\t\t},\r\n\t\t\ttype: {\r\n\t\t\t\ttype: String,\r\n\t\t\t\tdefault: \"\"\r\n\t\t\t},\r\n\t\t\tvisualization: {\r\n\t\t\t\ttype: String,\r\n\t\t\t\tdefault: \"\"\r\n\t\t\t},\r\n\t\t\tfieldKey: {\r\n\t\t\t\ttype: String,\r\n\t\t\t\tdefault: \"\"\r\n\t\t\t},\r\n\t\t\tunifiedMax: {\r\n\t\t\t\ttype: Number,\r\n\t\t\t\tdefault: null\r\n\t\t\t},\r\n\t\t\tcategoryColors: {\r\n\t\t\t\ttype: Object,\r\n\t\t\t\tdefault: () => ({})\r\n\t\t\t}\r\n\t\t},\r\n\r\n\t\temits: [\"chartClick\"],\r\n\r\n\t\tsetup(props, { emit }) {\r\n\t\t\t// ... setup 中的大部分逻辑保持不变\r\n\t\t\tconst hoveredIndex = ref(null);\r\n\t\t\tconst activeIndex = ref(null);\r\n\t\t\tconst isTextHovered = ref(false);\r\n\r\n\t\t\tconst pieContainer = ref(null);\r\n\t\t\tconst barContainer = ref(null);\r\n\t\t\tconst lineContainer = ref(null);\r\n\t\t\tconst stackedContainer = ref(null);\r\n\r\n\t\t\tconst colors = [\"#3498db\", \"#e74c3c\", \"#2ecc71\", \"#f39c12\", \"#9b59b6\"];\r\n\t\t\tconst remainderColor = \"#f0f0f0\";\r\n\r\n\t\t\tconst isYearEntry = value => {\r\n\t\t\t\tif (typeof value !== \"string\") return false;\r\n\t\t\t\tconst trimmedValue = value.trim();\r\n\t\t\t\treturn /^\\(\\d{4}\\)$/.test(trimmedValue);\r\n\t\t\t};\r\n\r\n\t\t\tconst safeToNumber = value => {\r\n\t\t\t\tif (value === null || value === undefined) return 0;\r\n\t\t\t\tif (typeof value === \"number\") return value;\r\n\t\t\t\tif (typeof value === \"string\") {\r\n\t\t\t\t\tif (value.includes(\"亿\"))\r\n\t\t\t\t\t\treturn parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 100000000;\r\n\t\t\t\t\tif (value.includes(\"万\"))\r\n\t\t\t\t\t\treturn parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 10000;\r\n\t\t\t\t\tif (value.includes(\"千\"))\r\n\t\t\t\t\t\treturn parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 1000;\r\n\t\t\t\t\tconst num = parseFloat(value.replace(/[^\\d,.-]/g, \"\"));\r\n\t\t\t\t\treturn isNaN(num) ? 0 : num;\r\n\t\t\t\t}\r\n\t\t\t\tif (typeof value === \"object\")\r\n\t\t\t\t\treturn safeToNumber(value.value || value.raw);\r\n\t\t\t\treturn 0;\r\n\t\t\t};\r\n\r\n\t\t\tconst processedField = computed(() => {\r\n\t\t\t\tconst field = props.field;\r\n\t\t\t\tif (!field || (Array.isArray(field) && field.length === 0)) return [];\r\n\r\n\t\t\t\tconst fieldAsArray = Array.isArray(field) ? field : [field];\r\n\r\n\t\t\t\treturn fieldAsArray\r\n\t\t\t\t\t.map(item => {\r\n\t\t\t\t\t\tif (typeof item === \"object\" && item !== null) {\r\n\t\t\t\t\t\t\treturn {\r\n\t\t\t\t\t\t\t\traw: item.raw ?? item.value ?? JSON.stringify(item),\r\n\t\t\t\t\t\t\t\tvalue: item.value ?? item.raw,\r\n\t\t\t\t\t\t\t\tlabel: item.label || item.raw,\r\n\t\t\t\t\t\t\t\tparent: item.parent || null\r\n\t\t\t\t\t\t\t};\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\treturn {\r\n\t\t\t\t\t\t\traw: String(item),\r\n\t\t\t\t\t\t\tvalue: item,\r\n\t\t\t\t\t\t\tlabel: String(item),\r\n\t\t\t\t\t\t\tparent: null\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t})\r\n\t\t\t\t\t.filter(\r\n\t\t\t\t\t\titem =>\r\n\t\t\t\t\t\t\titem.raw &&\r\n\t\t\t\t\t\t\tString(item.raw).trim() !== \"\" &&\r\n\t\t\t\t\t\t\t!isYearEntry(String(item.raw))\r\n\t\t\t\t\t);\r\n\t\t\t});\r\n\r\n\t\t\tconst getRawTextForRank = field => {\r\n\t\t\t\tif (!field || field.length === 0) return \"-\";\r\n\t\t\t\treturn field.map(item => item.raw).join(\"\\n\");\r\n\t\t\t};\r\n\r\n\t\t\tonMounted(() => {\r\n\t\t\t\twatch(\r\n\t\t\t\t\t() => [processedField.value, props.visualization, props.unifiedMax],\r\n\t\t\t\t\t() => {\r\n\t\t\t\t\t\tnextTick(() => {\r\n\t\t\t\t\t\t\tif (\r\n\t\t\t\t\t\t\t\tprops.visualization === \"pie-chart\" &&\r\n\t\t\t\t\t\t\t\thasData.value &&\r\n\t\t\t\t\t\t\t\tisValidPieData.value\r\n\t\t\t\t\t\t\t) {\r\n\t\t\t\t\t\t\t\trenderPieChartWithLegend(); // 调用更新后的函数\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t// ... 其他图表渲染调用保持不变\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t},\r\n\t\t\t\t\t{ immediate: true, deep: true }\r\n\t\t\t\t);\r\n\t\t\t});\r\n\r\n\t\t\t// ====================================================================\r\n\t\t\t// ========================= 饼图渲染函数（已重构） =========================\r\n\t\t\t// ====================================================================\r\n\t\t\tconst renderPieChartWithLegend = () => {\r\n\t\t\t\t// 1. 【初始化和清理】\r\n\t\t\t\tif (!pieContainer.value) return;\r\n\t\t\t\tconst container = d3.select(pieContainer.value);\r\n\t\t\t\tcontainer.selectAll(\"*\").remove(); // 清空所有内容\r\n\r\n\t\t\t\t// 2. 【设置布局】\r\n\t\t\t\tconst totalWidth = container.node().clientWidth;\r\n\t\t\t\tconst totalHeight = container.node().clientHeight;\r\n\r\n\t\t\t\t// 将容器分为图表区和图注区\r\n\t\t\t\tconst chartArea = container\r\n\t\t\t\t\t.append(\"div\")\r\n\t\t\t\t\t.attr(\"class\", \"pie-chart-area\");\r\n\t\t\t\tconst legendArea = container\r\n\t\t\t\t\t.append(\"div\")\r\n\t\t\t\t\t.attr(\"class\", \"pie-legend-area\");\r\n\r\n\t\t\t\t// 3. 【绘制饼图本身】\r\n\t\t\t\tconst chartWidth = chartArea.node().clientWidth;\r\n\t\t\t\tconst chartHeight = totalHeight;\r\n\t\t\t\tconst radius = (Math.min(chartWidth, chartHeight) / 2) * 0.9;\r\n\r\n\t\t\t\tconst svg = chartArea\r\n\t\t\t\t\t.append(\"svg\")\r\n\t\t\t\t\t.attr(\"width\", \"100%\")\r\n\t\t\t\t\t.attr(\"height\", \"100%\")\r\n\t\t\t\t\t.attr(\"viewBox\", `0 0 ${chartWidth} ${chartHeight}`)\r\n\t\t\t\t\t.append(\"g\")\r\n\t\t\t\t\t.attr(\r\n\t\t\t\t\t\t\"transform\",\r\n\t\t\t\t\t\t`translate(${chartWidth / 2}, ${chartHeight / 2})`\r\n\t\t\t\t\t);\r\n\r\n\t\t\t\tconst isSingleValue = props.fieldKey === \"Inflation (CPI)\";\r\n\t\t\t\tconst chartData =\r\n\t\t\t\t\tisSingleValue && pieData.value.length > 0\r\n\t\t\t\t\t\t? [\r\n\t\t\t\t\t\t\t\t{ ...pieData.value[0], color: colors[0] },\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\tvalue: Math.max(0, 100 - pieData.value[0].value),\r\n\t\t\t\t\t\t\t\t\tname: \"剩余\",\r\n\t\t\t\t\t\t\t\t\tcolor: remainderColor,\r\n\t\t\t\t\t\t\t\t\tisRemainder: true\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t  ]\r\n\t\t\t\t\t\t: pieData.value.map((d, i) => ({\r\n\t\t\t\t\t\t\t\t...d,\r\n\t\t\t\t\t\t\t\tcolor: colors[i % colors.length]\r\n\t\t\t\t\t\t  }));\r\n\r\n\t\t\t\tconst pie = d3\r\n\t\t\t\t\t.pie()\r\n\t\t\t\t\t.value(d => d.value)\r\n\t\t\t\t\t.sort(null);\r\n\t\t\t\tconst arc = d3.arc().innerRadius(0).outerRadius(radius);\r\n\r\n\t\t\t\t// Tooltip\r\n\t\t\t\tconst tooltip = container\r\n\t\t\t\t\t.append(\"div\")\r\n\t\t\t\t\t.attr(\"class\", \"d3-tooltip\")\r\n\t\t\t\t\t.style(\"position\", \"absolute\")\r\n\t\t\t\t\t.style(\"visibility\", \"hidden\");\r\n\r\n\t\t\t\t// 绘制扇区\r\n\t\t\t\tsvg\r\n\t\t\t\t\t.selectAll(\".arc\")\r\n\t\t\t\t\t.data(pie(chartData))\r\n\t\t\t\t\t.enter()\r\n\t\t\t\t\t.append(\"path\")\r\n\t\t\t\t\t.attr(\"d\", arc)\r\n\t\t\t\t\t.attr(\"fill\", d => d.data.color)\r\n\t\t\t\t\t.style(\"opacity\", 0.8)\r\n\t\t\t\t\t.style(\"stroke\", \"#fff\")\r\n\t\t\t\t\t.style(\"stroke-width\", 1)\r\n\t\t\t\t\t.on(\"mouseover\", function (event, d) {\r\n\t\t\t\t\t\tif (d.data.isRemainder) return;\r\n\t\t\t\t\t\td3.select(this).transition().duration(200).style(\"opacity\", 1);\r\n\t\t\t\t\t\ttooltip\r\n\t\t\t\t\t\t\t.style(\"visibility\", \"visible\")\r\n\t\t\t\t\t\t\t.html(`${d.data.name}: ${d.data.value.toFixed(1)}%`);\r\n\t\t\t\t\t})\r\n\t\t\t\t\t.on(\"mousemove\", event =>\r\n\t\t\t\t\t\ttooltip\r\n\t\t\t\t\t\t\t.style(\"top\", `${event.pageY - 10}px`)\r\n\t\t\t\t\t\t\t.style(\"left\", `${event.pageX + 10}px`)\r\n\t\t\t\t\t)\r\n\t\t\t\t\t.on(\"mouseout\", function (event, d) {\r\n\t\t\t\t\t\tif (d.data.isRemainder) return;\r\n\t\t\t\t\t\td3.select(this).transition().duration(200).style(\"opacity\", 0.8);\r\n\t\t\t\t\t\ttooltip.style(\"visibility\", \"hidden\");\r\n\t\t\t\t\t})\r\n\t\t\t\t\t.on(\"click\", (event, d) => {\r\n\t\t\t\t\t\tif (d.data.isRemainder) return;\r\n\t\t\t\t\t\temit(\"chartClick\", { type: \"pie\", ...d.data });\r\n\t\t\t\t\t});\r\n\r\n\t\t\t\t// 在中心显示文本\r\n\t\t\t\tif (isSingleValue && pieData.value.length > 0) {\r\n\t\t\t\t\tsvg\r\n\t\t\t\t\t\t.append(\"text\")\r\n\t\t\t\t\t\t.attr(\"text-anchor\"