teElementBlock(\"div\", _hoisted_11, \"-\"))], 64 /* STABLE_FRAGMENT */)) : (_openBlock(), _createElementBlock(_Fragment, {\n    key: 5\n  }, [_createCommentVNode(\" 默认显示 \"), _createElementVNode(\"div\", {\n    class: \"simple-text\",\n    onClick: _cache[3] || (_cache[3] = function () {\n      return _ctx.handleTextClick && _ctx.handleTextClick(...arguments);\n    }),\n    onMouseenter: _cache[4] || (_cache[4] = function () {\n      return _ctx.handleTextHover && _ctx.handleTextHover(...arguments);\n    }),\n    onMouseleave: _cache[5] || (_cache[5] = function () {\n      return _ctx.resetHover && _ctx.resetHover(...arguments);\n    })\n  }, _toDisplayString(_ctx.formatSimpleText(_ctx.processedField)), 33 /* TEXT, NEED_HYDRATION */), _ctx.isTextHovered ? (_openBlock(), _createElementBlock(\"div\", _hoisted_12, \"点击查看详情\")) : _createCommentVNode(\"v-if\", true)], 64 /* STABLE_FRAGMENT */))]);\n}","map":{"version":3,"names":["class","key","ref","_createElementBlock","_hoisted_1","_createCommentVNode","_ctx","visualization","_Fragment","fieldKey","_hoisted_2","_toDisplayString","getRawTextForRank","processedField","_createElementVNode","onClick","_cache","handleTextClick","arguments","onMouseenter","handleTextHover","onMouseleave","resetHover","formatSimpleText","isTextHovered","_hoisted_3","hasData","isValidPieData","_hoisted_4","_hoisted_5","_hoisted_6","_hoisted_7","_hoisted_8","_hoisted_9","_hoisted_10","_hoisted_11","_hoisted_12"],"sources":["D:\\vue_frame\\vue_frame\\wikitable-vue\\client\\src\\components\\compoents_base\\SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<!-- GDP Rank 的直接显示 -->\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<!-- 其他文本字段保持原样 -->\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 柱状图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 折线图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 堆叠图 -->\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script setup>\r\n\timport * as d3 from \"d3\";\r\n\timport { onMounted, ref, watch } from \"vue\";\r\n\r\n\t// 传入 props\r\n\tconst props = defineProps({\r\n\t\ttype: String,\r\n\t\tdata: Array,\r\n\t\tunit: String,\r\n\t\ttitle: String\r\n\t});\r\n\r\n\t// D3 容器引用\r\n\tconst chartContainer = ref(null);\r\n\r\n\t// 工具函数：格式化数字\r\n\tfunction formatNumber(value) {\r\n\t\tif (typeof value !== \"number\") return value;\r\n\t\tif (value >= 1e8) return (value / 1e8).toFixed(1) + \"亿\";\r\n\t\tif (value >= 1e4) return (value / 1e4).toFixed(1) + \"万\";\r\n\t\treturn value;\r\n\t}\r\n\r\n\t// 初始化 D3 图表\r\n\tfunction renderChart() {\r\n\t\tif (!chartContainer.value) return;\r\n\t\tconst container = d3.select(chartContainer.value);\r\n\t\tcontainer.selectAll(\"*\").remove();\r\n\r\n\t\tconst { type, data } = props;\r\n\t\tif (!data || data.length === 0) {\r\n\t\t\tcontainer.append(\"div\").attr(\"class\", \"no-data\").text(\"暂无数据\");\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tswitch (type) {\r\n\t\t\tcase \"pie\":\r\n\t\t\t\trenderPieChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"bar\":\r\n\t\t\t\trenderBarChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"line\":\r\n\t\t\t\trenderLineChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"stacked\":\r\n\t\t\t\trenderStackedChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\t/* ===========================\r\n   饼图\r\n=========================== */\r\n\tfunction renderPieChart(container, data) {\r\n\t\tconst width = 160;\r\n\t\tconst height = 160;\r\n\t\tconst radius = Math.min(width, height) / 2;\r\n\r\n\t\tconst color = d3.scaleOrdinal(d3.schemeCategory10);\r\n\t\tconst pie = d3.pie().value(d => d.value);\r\n\t\tconst arc = d3\r\n\t\t\t.arc()\r\n\t\t\t.outerRadius(radius - 10)\r\n\t\t\t.innerRadius(0);\r\n\r\n\t\tconst svg = container\r\n\t\t\t.append(\"svg\")\r\n\t\t\t.attr(\"width\", width)\r\n\t\t\t.attr(\"height\", height)\r\n\t\t\t.style(\"font-family\", \"Arial, sans-serif\")\r\n\t\t\t.style(\"font-size\", \"13px\")\r\n\t\t\t.style(\"color\", \"#000\")\r\n\t\t\t.append(\"g\")\r\n\t\t\t.attr(\"transform\", `translate(${width / 2},${height / 2})`);\r\n\r\n\t\tconst g = svg\r\n\t\t\t.selectAll(\".arc\")\r\n\t\t\t.data(pie(data))\r\n\t\t\t.enter()\r\n\t\t\t.append(\"g\")\r\n\t\t\t.attr(\"class\", \"arc\");\r\n\r\n\t\tg.append(\"path\")\r\n\t\t\t.attr(\"d\", arc)\r\n\t\t\t.attr(\"fill\", d => color(d.data.name));\r\n\r\n\t\t// 标签文字\r\n\t\tg.append(\"text\")\r\n\t\t\t.attr(\"transform\", d => `translate(${arc.centroid(d)})`)\r\n\t\t\t.attr(\"dy\", \"0.35em\")\r\n\t\t\t.style(\"text-anchor\", \"middle\")\r\n\t\t\t.style(\"font-size\", \"16px\")\r\n\t\t\t.style(\"fill\", \"#000\")\r\n\t\t\t.style(\"font-weight\", \"600\")\r\n\t\t\t.text(d => formatNumber(d.data.value));\r\n\r\n\t\t// 图例\r\n\t\tconst legend = svg\r\n\t\t\t.selectAll(\".legend\")\r\n\t\t\t.data(data)\r\n\t\t\t.enter()\r\n\t\t\t.append(\"g\")\r\n\t\t\t.attr(\"transform\", (d, i) => `translate(-40,${i * 16 - 60})`);\r\n\r\n\t\tlegend\r\n\t\t\t.append(\"rect\")\r\n\t\t\t.attr(\"x\", radius - 10)\r\n\t\t\t.attr(\"width\", 10)\r\n\t\t\t.attr(\"height\", 10)\r\n\t\t\t.attr(\"fill\", d => color(d.name));\r\n\r\n\t\tlegend\r\n\t\t\t.append(\"text\")\r\n\t\t\t.attr(\"x\", radius + 4)\r\n\t\t\t.attr(\"y\", 9)\r\n\t\t\t.style(\"font-size\", \"13px\")\r\n\t\t\t.style(\"fill\", \"#000\")\r\n\t\t\t.style(\"font-weight\", \"500\")\r\n\t\t\t.text(d => d.name);\r\n\t}\r\n\r\n\t/* ===========================\r\n   柱状图\r\n=========================== */\r\n\tfunction renderBarChart(container, data) {\r\n\t\tconst margin = { top: 20, right: 20, bottom: 30, left: 40 };\r\n\t\tconst width = 200 - margin.left - margin.right;\r\n\t\tconst height = 160 - margin.top - margin.bottom;\r\n\r\n\t\tconst svg = container\r\n\t\t\t.append(\"svg\")\r\n\t\t\t.attr(\"width\", width + margin.left + margin.right)\r\n\t\t\t.attr(\"height\", height + margin.top + margin.bottom)\r\n\t\t\t.style(\"font-family\", \"Arial, sans-serif\")\r\n\t\t\t.style(\"font-size\", \"13px\")\r\n\t\t\t.style(\"color\", \"#000\")\r\n\t\t\t.append(\"g\")\r\n\t\t\t.attr(\"transform\", `translate(${margin.left},${margin.top})`);\r\n\r\n\t\tconst x = d3.scaleBand().range([0, width]).padding(0.1);\r\n\t\tconst y = d3.scaleLinear().range([height, 0]);\r\n\r\n\t\tx.domain(data.map(d => d.name));\r\n\t\ty.domain([0, d3.max(data, d => d.value)]);\r\n\r\n\t\tsvg\r\n\t\t\t.selectAll(\".bar\")\r\n\t\t\t.data(data)\r\n\t\t\t.enter()\r\n\t\t\t.append(\"rect\")\r\n\t\t\t.attr(\"class\", \"bar\")\r\n\t\t\t.attr(\"x\", d => x(d.name))\r\n\t\t\t.attr(\"width\", x.bandwidth())\r\n\t\t\t.attr(\"y\", d => y(d.value))\r\n\t\t\t.attr(\"height\", d => height - y(d.value))\r\n\t\t\t.attr(\"fill\", \"#69b3a2\");\r\n\r\n\t\tsvg\r\n\t\t\t.selectAll(\".bar-text\")\r\n\t\t\t.data(data)\r\n\t\t\t.enter()\r\n\t\t\t.append(\"text\")\r\n\t\t\t.attr(\"x\", d => x(d.name) + x.bandwidth() / 2)\r\n\t\t\t.attr(\"y\", d => y(d.value) - 5)\r\n\t\t\t.attr(\"text-anchor\", \"middle\")\r\n\t\t\t.attr(\"font-size\", \"13px\")\r\n\t\t\t.attr(\"fill\", \"#000\")\r\n\t\t\t.attr(\"font-weight\", \"600\")\r\n\t\t\t.text(d => formatNumber(d.value));\r\n\t}\r\n\r\n\t/* ===========================\r\n   折线图\r\n=========================== */\r\n\tfunction renderLineChart(container, data) {\r\n\t\tconst margin = { top: 20, right: 20, bottom: 30, left: 40 };\r\n\t\tconst width = 200 - margin.left - margin.right;\r\n\t\tconst height = 160 - margin.top - margin.bottom;\r\n\r\n\t\tconst svg = container\r\n\t\t\t.append(\"svg\")\r\n\t\t\t.attr(\"width\", width + margin.left + margin.right)\r\n\t\t\t.attr(\"height\", height + margin.top + margin.bottom)\r\n\t\t\t.style(\"font-family\", \"Arial, sans-serif\")\r\n\t\t\t.style(\"font-size\", \"13px\")\r\n\t\t\t.style(\"color\", \"#000\")\r\n\t\t\t.append(\"g\")\r\n\t\t\t.attr(\"transform\", `translate(${margin.left},${margin.top})`);\r\n\r\n\t\tconst x = d3\r\n\t\t\t.scalePoint()\r\n\t\t\t.range([0, width])\r\n\t\t\t.domain(data.map(d => d.name));\r\n\t\tconst y = d3\r\n\t\t\t.scaleLinear()\r\n\t\t\t.range([height, 0])\r\n\t\t\t.domain([0, d3.max(data, d => d.value)]);\r\n\r\n\t\tconst line = d3\r\n\t\t\t.line()\r\n\t\t\t.x(d => x(d.name))\r\n\t\t\t.y(d => y(d.value));\r\n\r\n\t\tsvg\r\n\t\t\t.append(\"path\")\r\n\t\t\t.datum(data)\r\n\t\t\t.attr(\"fill\", \"none\")\r\n\t\t\t.attr(\"stroke\", \"#69b3a2\")\r\n\t\t\t.attr(\"stroke-width\", 2)\r\n\t\t\t.attr(\"d\", line);\r\n\r\n\t\tsvg\r\n\t\t\t.selectAll(\".dot\")\r\n\t\t\t.data(data)\r\n\t\t\t.enter()\r\n\t\t\t.append(\"circle\")\r\n\t\t\t.attr(\"cx\", d => x(d.name))\r\n\t\t\t.attr(\"cy\", d => y(d.value))\r\n\t\t\t.attr(\"r\", 3)\r\n\t\t\t.attr(\"fill\", \"#69b3a2\");\r\n\r\n\t\tsvg\r\n\t\t\t.selectAll(\".dot-label\")\r\n\t\t\t.data(data)\r\n\t\t\t.enter()\r\n\t\t\t.append(\"text\")\r\n\t\t\t.attr(\"x\", d => x(d.name))\r\n\t\t\t.attr(\"y\", d => y(d.value) - 8)\r\n\t\t\t.attr(\"text-anchor\", \"middle\")\r\n\t\t\t.attr(\"font-size\", \"13px\")\r\n\t\t\t.attr(\"fill\", \"#000\")\r\n\t\t\t.attr(\"font-weight\", \"600\")\r\n\t\t\t.text(d => formatNumber(d.value));\r\n\t}\r\n\r\n\t/* ===========================\r\n   堆叠图\r\n=========================== */\r\n\tfunction renderStackedChart(container, data) {\r\n\t\tconst margin = { top: 20, right: 20, bottom: 30, left: 40 };\r\n\t\tconst width = 200 - margin.left - margin.right;\r\n\t\tconst height = 160 - margin.top - margin.bottom;\r\n\r\n\t\tconst svg = container\r\n\t\t\t.append(\"svg\")\r\n\t\t\t.attr(\"width\", width + margin.left + margin.right)\r\n\t\t\t.attr(\"height\", height + margin.top + margin.bottom)\r\n\t\t\t.style(\"font-family\", \"Arial, sans-serif\")\r\n\t\t\t.style(\"font-size\", \"13px\")\r\n\t\t\t.style(\"color\", \"#000\")\r\n\t\t\t.append(\"g\")\r\n\t\t\t.attr(\"transform\", `translate(${margin.left},${margin.top})`);\r\n\r\n\t\tconst subgroups = Object.keys(data[0]).filter(k => k !== \"name\");\r\n\t\tconst groups = data.map(d => d.name);\r\n\r\n\t\tconst x = d3.scaleBand().domain(groups).range([0, width]).padding([0.2]);\r\n\t\tconst y = d3\r\n\t\t\t.scaleLinear()\r\n\t\t\t.domain([0, d3.max(data, d => d3.sum(subgroups, k => d[k])