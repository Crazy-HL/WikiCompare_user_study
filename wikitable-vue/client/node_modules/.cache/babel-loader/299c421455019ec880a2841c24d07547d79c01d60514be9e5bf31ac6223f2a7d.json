{"ast":null,"code":"import { computed, ref, onMounted, watch, nextTick } from \"vue\";\nimport * as d3 from \"d3\";\nexport default {\n  props: {\n    field: {\n      type: [Object, Array, String, Number],\n      default: null\n    },\n    type: {\n      type: String,\n      default: \"\"\n    },\n    visualization: {\n      type: String,\n      default: \"\"\n    },\n    fieldKey: {\n      type: String,\n      default: \"\"\n    },\n    unifiedMax: {\n      type: Number,\n      default: null\n    },\n    categoryColors: {\n      type: Object,\n      default: () => ({})\n    }\n  },\n  emits: [\"chartClick\"],\n  setup(props, _ref) {\n    let {\n      emit\n    } = _ref;\n    const hoveredIndex = ref(null);\n    const activeIndex = ref(null);\n    const isTextHovered = ref(false);\n    const pieContainer = ref(null);\n    const barContainer = ref(null);\n    const lineContainer = ref(null);\n    const stackedContainer = ref(null);\n\n    /* ===================== 辅助函数 ===================== */\n    const isYearEntry = v => typeof v === \"string\" && /^\\(\\d{4}/.test(v.trim());\n    const safeToNumber = v => {\n      if (v == null) return 0;\n      if (typeof v === \"number\") return v;\n      const num = parseFloat(String(v).replace(/[^\\d.-]/g, \"\"));\n      return isNaN(num) ? 0 : num;\n    };\n    const processedField = computed(() => {\n      const field = props.field;\n      if (!field || Array.isArray(field) && field.length === 0) return [];\n      const fieldArr = Array.isArray(field) ? field : [field];\n      return fieldArr.map(item => typeof item === \"object\" && item !== null ? {\n        raw: item.raw ?? item.value ?? JSON.stringify(item),\n        value: item.value ?? item.raw,\n        label: item.label || item.raw\n      } : {\n        raw: String(item),\n        value: item,\n        label: String(item)\n      }).filter(it => it.raw && String(it.raw).trim() !== \"\" && !isYearEntry(it.raw));\n    });\n    const getRawTextForRank = field => !field || field.length === 0 ? \"-\" : field.map(f => f.raw).join(\"\\n\");\n\n    /* ===================== 格式化函数 ===================== */\n    const formatSimpleText = val => {\n      if (!val || val.length === 0) return \"-\";\n      const arr = val.map(v => v.raw || v.value);\n      return arr.length > 3 ? arr.slice(0, 3).join(\"; \") + \"...\" : arr.join(\"; \");\n    };\n    const formatNumber = n => {\n      const num = Number(n);\n      if (isNaN(num)) return \"0\";\n      if (props.type === \"percentage\") return num.toFixed(1) + \"%\";\n      if (num >= 1e8) return (num / 1e8).toFixed(1) + \"亿\";\n      if (num >= 1e4) return (num / 1e4).toFixed(1) + \"万\";\n      return num.toFixed(1);\n    };\n\n    /* ===================== 数据源 ===================== */\n    const pieData = computed(() => (processedField.value || []).map((it, i) => ({\n      value: safeToNumber(it.value),\n      name: String(it.label || it.raw),\n      index: i\n    })).filter(d => d.value > 0));\n    const isValidPieData = computed(() => pieData.value.length > 0);\n    const hasData = computed(() => processedField.value.length > 0);\n\n    /* ===================== 渲染逻辑 ===================== */\n    const renderPieChart = () => {\n      if (!pieContainer.value) return;\n      d3.select(pieContainer.value).selectAll(\"*\").remove();\n      const container = d3.select(pieContainer.value);\n      const width = pieContainer.value.clientWidth;\n      const height = pieContainer.value.clientHeight;\n      const radius = Math.min(width, height) / 2 - 10;\n      const svg = container.append(\"svg\").attr(\"width\", width).attr(\"height\", height).append(\"g\").attr(\"transform\", `translate(${width / 2}, ${height / 2})`);\n      const color = d3.scaleOrdinal(d3.schemeTableau10);\n      const pie = d3.pie().value(d => d.value);\n      const arc = d3.arc().innerRadius(0).outerRadius(radius);\n      const arcs = svg.selectAll(\"arc\").data(pie(pieData.value)).enter().append(\"g\");\n      arcs.append(\"path\").attr(\"d\", arc).attr(\"fill\", (d, i) => color(i)).style(\"stroke\", \"#fff\").style(\"stroke-width\", \"1px\");\n\n      // 修改字体大小 & 颜色\n      arcs.append(\"text\").attr(\"transform\", d => `translate(${arc.centroid(d)})`).attr(\"text-anchor\", \"middle\").attr(\"font-size\", \"16px\").attr(\"fill\", \"#000\").text(d => `${d.data.name}`);\n    };\n    const renderBarChart = () => {\n      if (!barContainer.value) return;\n      d3.select(barContainer.value).selectAll(\"*\").remove();\n      const container = d3.select(barContainer.value);\n      const width = barContainer.value.clientWidth;\n      const height = barContainer.value.clientHeight;\n      const svg = container.append(\"svg\").attr(\"width\", width).attr(\"height\", height);\n      const data = pieData.value;\n      const x = d3.scaleBand().domain(data.map(d => d.name)).range([40, width - 20]).padding(0.2);\n      const y = d3.scaleLinear().domain([0, d3.max(data, d => d.value)]).range([height - 30, 10]);\n      svg.selectAll(\"rect\").data(data).enter().append(\"rect\").attr(\"x\", d => x(d.name)).attr(\"y\", d => y(d.value)).attr(\"width\", x.bandwidth()).attr(\"height\", d => height - 30 - y(d.value)).attr(\"fill\", \"#3498db\");\n      svg.selectAll(\"text\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.name) + x.bandwidth() / 2).attr(\"y\", d => y(d.value) - 5).attr(\"text-anchor\", \"middle\").attr(\"font-size\", \"16px\").attr(\"fill\", \"#000\").text(d => d.value);\n    };\n\n    /* ===================== 监听更新 ===================== */\n    onMounted(() => {\n      watch(() => [processedField.value, props.visualization], () => {\n        nextTick(() => {\n          if (props.visualization === \"pie-chart\" && hasData.value) renderPieChart();\n          if (props.visualization === \"bar-chart\" && hasData.value) renderBarChart();\n        });\n      }, {\n        immediate: true,\n        deep: true\n      });\n    });\n    const handleTextHover = () => isTextHovered.value = true;\n    const resetHover = () => isTextHovered.value = false;\n    const handleTextClick = () => emit(\"chartClick\", {\n      type: \"text\",\n      data: processedField.value\n    });\n    return {\n      isTextHovered,\n      handleTextHover,\n      resetHover,\n      handleTextClick,\n      formatSimpleText,\n      getRawTextForRank,\n      processedField,\n      hasData,\n      isValidPieData,\n      pieContainer,\n      barContainer\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","watch","nextTick","d3","props","field","type","Object","Array","String","Number","default","visualization","fieldKey","unifiedMax","categoryColors","emits","setup","_ref","emit","hoveredIndex","activeIndex","isTextHovered","pieContainer","barContainer","lineContainer","stackedContainer","isYearEntry","v","test","trim","safeToNumber","num","parseFloat","replace","isNaN","processedField","isArray","length","fieldArr","map","item","raw","value","JSON","stringify","label","filter","it","getRawTextForRank","f","join","formatSimpleText","val","arr","slice","formatNumber","n","toFixed","pieData","i","name","index","d","isValidPieData","hasData","renderPieChart","select","selectAll","remove","container","width","clientWidth","height","clientHeight","radius","Math","min","svg","append","attr","color","scaleOrdinal","schemeTableau10","pie","arc","innerRadius","outerRadius","arcs","data","enter","style","centroid","text","renderBarChart","x","scaleBand","domain","range","padding","y","scaleLinear","max","bandwidth","immediate","deep","handleTextHover","resetHover","handleTextClick"],"sources":["D:\\vue_frame\\vue_frame\\wikitable-vue\\client\\src\\components\\compoents_base\\SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<!-- GDP Rank 的直接显示 -->\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<!-- 其他文本字段保持原样 -->\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 柱状图 -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 折线图 -->\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 堆叠图 -->\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\timport { computed, ref, onMounted, watch, nextTick } from \"vue\";\r\n\timport * as d3 from \"d3\";\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\tfield: { type: [Object, Array, String, Number], default: null },\r\n\t\t\ttype: { type: String, default: \"\" },\r\n\t\t\tvisualization: { type: String, default: \"\" },\r\n\t\t\tfieldKey: { type: String, default: \"\" },\r\n\t\t\tunifiedMax: { type: Number, default: null },\r\n\t\t\tcategoryColors: { type: Object, default: () => ({}) }\r\n\t\t},\r\n\r\n\t\temits: [\"chartClick\"],\r\n\r\n\t\tsetup(props, { emit }) {\r\n\t\t\tconst hoveredIndex = ref(null);\r\n\t\t\tconst activeIndex = ref(null);\r\n\t\t\tconst isTextHovered = ref(false);\r\n\r\n\t\t\tconst pieContainer = ref(null);\r\n\t\t\tconst barContainer = ref(null);\r\n\t\t\tconst lineContainer = ref(null);\r\n\t\t\tconst stackedContainer = ref(null);\r\n\r\n\t\t\t/* ===================== 辅助函数 ===================== */\r\n\t\t\tconst isYearEntry = v =>\r\n\t\t\t\ttypeof v === \"string\" && /^\\(\\d{4}/.test(v.trim());\r\n\t\t\tconst safeToNumber = v => {\r\n\t\t\t\tif (v == null) return 0;\r\n\t\t\t\tif (typeof v === \"number\") return v;\r\n\t\t\t\tconst num = parseFloat(String(v).replace(/[^\\d.-]/g, \"\"));\r\n\t\t\t\treturn isNaN(num) ? 0 : num;\r\n\t\t\t};\r\n\r\n\t\t\tconst processedField = computed(() => {\r\n\t\t\t\tconst field = props.field;\r\n\t\t\t\tif (!field || (Array.isArray(field) && field.length === 0)) return [];\r\n\t\t\t\tconst fieldArr = Array.isArray(field) ? field : [field];\r\n\t\t\t\treturn fieldArr\r\n\t\t\t\t\t.map(item =>\r\n\t\t\t\t\t\ttypeof item === \"object\" && item !== null\r\n\t\t\t\t\t\t\t? {\r\n\t\t\t\t\t\t\t\t\traw: item.raw ?? item.value ?? JSON.stringify(item),\r\n\t\t\t\t\t\t\t\t\tvalue: item.value ?? item.raw,\r\n\t\t\t\t\t\t\t\t\tlabel: item.label || item.raw\r\n\t\t\t\t\t\t\t  }\r\n\t\t\t\t\t\t\t: { raw: String(item), value: item, label: String(item) }\r\n\t\t\t\t\t)\r\n\t\t\t\t\t.filter(\r\n\t\t\t\t\t\tit => it.raw && String(it.raw).trim() !== \"\" && !isYearEntry(it.raw)\r\n\t\t\t\t\t);\r\n\t\t\t});\r\n\r\n\t\t\tconst getRawTextForRank = field =>\r\n\t\t\t\t!field || field.length === 0 ? \"-\" : field.map(f => f.raw).join(\"\\n\");\r\n\r\n\t\t\t/* ===================== 格式化函数 ===================== */\r\n\t\t\tconst formatSimpleText = val => {\r\n\t\t\t\tif (!val || val.length === 0) return \"-\";\r\n\t\t\t\tconst arr = val.map(v => v.raw || v.value);\r\n\t\t\t\treturn arr.length > 3\r\n\t\t\t\t\t? arr.slice(0, 3).join(\"; \") + \"...\"\r\n\t\t\t\t\t: arr.join(\"; \");\r\n\t\t\t};\r\n\t\t\tconst formatNumber = n => {\r\n\t\t\t\tconst num = Number(n);\r\n\t\t\t\tif (isNaN(num)) return \"0\";\r\n\t\t\t\tif (props.type === \"percentage\") return num.toFixed(1) + \"%\";\r\n\t\t\t\tif (num >= 1e8) return (num / 1e8).toFixed(1) + \"亿\";\r\n\t\t\t\tif (num >= 1e4) return (num / 1e4).toFixed(1) + \"万\";\r\n\t\t\t\treturn num.toFixed(1);\r\n\t\t\t};\r\n\r\n\t\t\t/* ===================== 数据源 ===================== */\r\n\t\t\tconst pieData = computed(() =>\r\n\t\t\t\t(processedField.value || [])\r\n\t\t\t\t\t.map((it, i) => ({\r\n\t\t\t\t\t\tvalue: safeToNumber(it.value),\r\n\t\t\t\t\t\tname: String(it.label || it.raw),\r\n\t\t\t\t\t\tindex: i\r\n\t\t\t\t\t}))\r\n\t\t\t\t\t.filter(d => d.value > 0)\r\n\t\t\t);\r\n\t\t\tconst isValidPieData = computed(() => pieData.value.length > 0);\r\n\t\t\tconst hasData = computed(() => processedField.value.length > 0);\r\n\r\n\t\t\t/* ===================== 渲染逻辑 ===================== */\r\n\t\t\tconst renderPieChart = () => {\r\n\t\t\t\tif (!pieContainer.value) return;\r\n\t\t\t\td3.select(pieContainer.value).selectAll(\"*\").remove();\r\n\t\t\t\tconst container = d3.select(pieContainer.value);\r\n\t\t\t\tconst width = pieContainer.value.clientWidth;\r\n\t\t\t\tconst height = pieContainer.value.clientHeight;\r\n\t\t\t\tconst radius = Math.min(width, height) / 2 - 10;\r\n\r\n\t\t\t\tconst svg = container\r\n\t\t\t\t\t.append(\"svg\")\r\n\t\t\t\t\t.attr(\"width\", width)\r\n\t\t\t\t\t.attr(\"height\", height)\r\n\t\t\t\t\t.append(\"g\")\r\n\t\t\t\t\t.attr(\"transform\", `translate(${width / 2}, ${height / 2})`);\r\n\r\n\t\t\t\tconst color = d3.scaleOrdinal(d3.schemeTableau10);\r\n\t\t\t\tconst pie = d3.pie().value(d => d.value);\r\n\t\t\t\tconst arc = d3.arc().innerRadius(0).outerRadius(radius);\r\n\r\n\t\t\t\tconst arcs = svg\r\n\t\t\t\t\t.selectAll(\"arc\")\r\n\t\t\t\t\t.data(pie(pieData.value))\r\n\t\t\t\t\t.enter()\r\n\t\t\t\t\t.append(\"g\");\r\n\r\n\t\t\t\tarcs\r\n\t\t\t\t\t.append(\"path\")\r\n\t\t\t\t\t.attr(\"d\", arc)\r\n\t\t\t\t\t.attr(\"fill\", (d, i) => color(i))\r\n\t\t\t\t\t.style(\"stroke\", \"#fff\")\r\n\t\t\t\t\t.style(\"stroke-width\", \"1px\");\r\n\r\n\t\t\t\t// 修改字体大小 & 颜色\r\n\t\t\t\tarcs\r\n\t\t\t\t\t.append(\"text\")\r\n\t\t\t\t\t.attr(\"transform\", d => `translate(${arc.centroid(d)})`)\r\n\t\t\t\t\t.attr(\"text-anchor\", \"middle\")\r\n\t\t\t\t\t.attr(\"font-size\", \"16px\")\r\n\t\t\t\t\t.attr(\"fill\", \"#000\")\r\n\t\t\t\t\t.text(d => `${d.data.name}`);\r\n\t\t\t};\r\n\r\n\t\t\tconst renderBarChart = () => {\r\n\t\t\t\tif (!barContainer.value) return;\r\n\t\t\t\td3.select(barContainer.value).selectAll(\"*\").remove();\r\n\t\t\t\tconst container = d3.select(barContainer.value);\r\n\t\t\t\tconst width = barContainer.value.clientWidth;\r\n\t\t\t\tconst height = barContainer.value.clientHeight;\r\n\t\t\t\tconst svg = container\r\n\t\t\t\t\t.append(\"svg\")\r\n\t\t\t\t\t.attr(\"width\", width)\r\n\t\t\t\t\t.attr(\"height\", height);\r\n\t\t\t\tconst data = pieData.value;\r\n\t\t\t\tconst x = d3\r\n\t\t\t\t\t.scaleBand()\r\n\t\t\t\t\t.domain(data.map(d => d.name))\r\n\t\t\t\t\t.range([40, width - 20])\r\n\t\t\t\t\t.padding(0.2);\r\n\t\t\t\tconst y = d3\r\n\t\t\t\t\t.scaleLinear()\r\n\t\t\t\t\t.domain([0, d3.max(data, d => d.value)])\r\n\t\t\t\t\t.range([height - 30, 10]);\r\n\t\t\t\tsvg\r\n\t\t\t\t\t.selectAll(\"rect\")\r\n\t\t\t\t\t.data(data)\r\n\t\t\t\t\t.enter()\r\n\t\t\t\t\t.append(\"rect\")\r\n\t\t\t\t\t.attr(\"x\", d => x(d.name))\r\n\t\t\t\t\t.attr(\"