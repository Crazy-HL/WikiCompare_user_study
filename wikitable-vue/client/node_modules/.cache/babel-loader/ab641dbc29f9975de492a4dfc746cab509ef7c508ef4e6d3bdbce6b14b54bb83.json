{"ast":null,"code":"import * as d3 from \"d3\";\nimport { onMounted, ref, watch } from \"vue\";\n\n// 传入 props\n\nexport default {\n  __name: 'SimpleChart',\n  props: {\n    type: String,\n    data: Array,\n    unit: String,\n    title: String\n  },\n  setup(__props, _ref) {\n    let {\n      expose: __expose\n    } = _ref;\n    __expose();\n    const props = __props;\n\n    // D3 容器引用\n    const chartContainer = ref(null);\n\n    // 工具函数：格式化数字\n    function formatNumber(value) {\n      if (typeof value !== \"number\") return value;\n      if (value >= 1e8) return (value / 1e8).toFixed(1) + \"亿\";\n      if (value >= 1e4) return (value / 1e4).toFixed(1) + \"万\";\n      return value;\n    }\n\n    // 初始化 D3 图表\n    function renderChart() {\n      if (!chartContainer.value) return;\n      const container = d3.select(chartContainer.value);\n      container.selectAll(\"*\").remove();\n      const {\n        type,\n        data\n      } = props;\n      if (!data || data.length === 0) {\n        container.append(\"div\").attr(\"class\", \"no-data\").text(\"暂无数据\");\n        return;\n      }\n      switch (type) {\n        case \"pie\":\n          renderPieChart(container, data);\n          break;\n        case \"bar\":\n          renderBarChart(container, data);\n          break;\n        case \"line\":\n          renderLineChart(container, data);\n          break;\n        case \"stacked\":\n          renderStackedChart(container, data);\n          break;\n        default:\n          break;\n      }\n    }\n\n    /* ===========================\r\n      饼图\r\n    =========================== */\n    function renderPieChart(container, data) {\n      const width = 160;\n      const height = 160;\n      const radius = Math.min(width, height) / 2;\n      const color = d3.scaleOrdinal(d3.schemeCategory10);\n      const pie = d3.pie().value(d => d.value);\n      const arc = d3.arc().outerRadius(radius - 10).innerRadius(0);\n      const svg = container.append(\"svg\").attr(\"width\", width).attr(\"height\", height).style(\"font-family\", \"Arial, sans-serif\").style(\"font-size\", \"13px\").style(\"color\", \"#000\").append(\"g\").attr(\"transform\", `translate(${width / 2},${height / 2})`);\n      const g = svg.selectAll(\".arc\").data(pie(data)).enter().append(\"g\").attr(\"class\", \"arc\");\n      g.append(\"path\").attr(\"d\", arc).attr(\"fill\", d => color(d.data.name));\n\n      // 标签文字\n      g.append(\"text\").attr(\"transform\", d => `translate(${arc.centroid(d)})`).attr(\"dy\", \"0.35em\").style(\"text-anchor\", \"middle\").style(\"font-size\", \"16px\").style(\"fill\", \"#000\").style(\"font-weight\", \"600\").text(d => formatNumber(d.data.value));\n\n      // 图例\n      const legend = svg.selectAll(\".legend\").data(data).enter().append(\"g\").attr(\"transform\", (d, i) => `translate(-40,${i * 16 - 60})`);\n      legend.append(\"rect\").attr(\"x\", radius - 10).attr(\"width\", 10).attr(\"height\", 10).attr(\"fill\", d => color(d.name));\n      legend.append(\"text\").attr(\"x\", radius + 4).attr(\"y\", 9).style(\"font-size\", \"13px\").style(\"fill\", \"#000\").style(\"font-weight\", \"500\").text(d => d.name);\n    }\n\n    /* ===========================\r\n      柱状图\r\n    =========================== */\n    function renderBarChart(container, data) {\n      const margin = {\n        top: 20,\n        right: 20,\n        bottom: 30,\n        left: 40\n      };\n      const width = 200 - margin.left - margin.right;\n      const height = 160 - margin.top - margin.bottom;\n      const svg = container.append(\"svg\").attr(\"width\", width + margin.left + margin.right).attr(\"height\", height + margin.top + margin.bottom).style(\"font-family\", \"Arial, sans-serif\").style(\"font-size\", \"13px\").style(\"color\", \"#000\").append(\"g\").attr(\"transform\", `translate(${margin.left},${margin.top})`);\n      const x = d3.scaleBand().range([0, width]).padding(0.1);\n      const y = d3.scaleLinear().range([height, 0]);\n      x.domain(data.map(d => d.name));\n      y.domain([0, d3.max(data, d => d.value)]);\n      svg.selectAll(\".bar\").data(data).enter().append(\"rect\").attr(\"class\", \"bar\").attr(\"x\", d => x(d.name)).attr(\"width\", x.bandwidth()).attr(\"y\", d => y(d.value)).attr(\"height\", d => height - y(d.value)).attr(\"fill\", \"#69b3a2\");\n      svg.selectAll(\".bar-text\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.name) + x.bandwidth() / 2).attr(\"y\", d => y(d.value) - 5).attr(\"text-anchor\", \"middle\").attr(\"font-size\", \"13px\").attr(\"fill\", \"#000\").attr(\"font-weight\", \"600\").text(d => formatNumber(d.value));\n    }\n\n    /* ===========================\r\n      折线图\r\n    =========================== */\n    function renderLineChart(container, data) {\n      const margin = {\n        top: 20,\n        right: 20,\n        bottom: 30,\n        left: 40\n      };\n      const width = 200 - margin.left - margin.right;\n      const height = 160 - margin.top - margin.bottom;\n      const svg = container.append(\"svg\").attr(\"width\", width + margin.left + margin.right).attr(\"height\", height + margin.top + margin.bottom).style(\"font-family\", \"Arial, sans-serif\").style(\"font-size\", \"13px\").style(\"color\", \"#000\").append(\"g\").attr(\"transform\", `translate(${margin.left},${margin.top})`);\n      const x = d3.scalePoint().range([0, width]).domain(data.map(d => d.name));\n      const y = d3.scaleLinear().range([height, 0]).domain([0, d3.max(data, d => d.value)]);\n      const line = d3.line().x(d => x(d.name)).y(d => y(d.value));\n      svg.append(\"path\").datum(data).attr(\"fill\", \"none\").attr(\"stroke\", \"#69b3a2\").attr(\"stroke-width\", 2).attr(\"d\", line);\n      svg.selectAll(\".dot\").data(data).enter().append(\"circle\").attr(\"cx\", d => x(d.name)).attr(\"cy\", d => y(d.value)).attr(\"r\", 3).attr(\"fill\", \"#69b3a2\");\n      svg.selectAll(\".dot-label\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.name)).attr(\"y\", d => y(d.value) - 8).attr(\"text-anchor\", \"middle\").attr(\"font-size\", \"13px\").attr(\"fill\", \"#000\").attr(\"font-weight\", \"600\").text(d => formatNumber(d.value));\n    }\n\n    /* ===========================\r\n      堆叠图\r\n    =========================== */\n    function renderStackedChart(container, data) {\n      const margin = {\n        top: 20,\n        right: 20,\n        bottom: 30,\n        left: 40\n      };\n      const width = 200 - margin.left - margin.right;\n      const height = 160 - margin.top - margin.bottom;\n      const svg = container.append(\"svg\").attr(\"width\", width + margin.left + margin.right).attr(\"height\", height + margin.top + margin.bottom).style(\"font-family\", \"Arial, sans-serif\").style(\"font-size\", \"13px\").style(\"color\", \"#000\").append(\"g\").attr(\"transform\", `translate(${margin.left},${margin.top})`);\n      const subgroups = Object.keys(data[0]).filter(k => k !== \"name\");\n      const groups = data.map(d => d.name);\n      const x = d3.scaleBand().domain(groups).range([0, width]).padding([0.2]);\n      const y = d3.scaleLinear().domain([0, d3.max(data, d => d3.sum(subgroups, k => d[k]))]).range([height, 0]);\n      const color = d3.scaleOrdinal().domain(subgroups).range(d3.schemeCategory10);\n      const stackedData = d3.stack().keys(subgroups)(data);\n      svg.append(\"g\").selectAll(\"g\").data(stackedData).enter().append(\"g\").attr(\"fill\", d => color(d.key)).selectAll(\"rect\").data(d => d).enter().append(\"rect\").attr(\"x\", d => x(d.data.name)).attr(\"y\", d => y(d[1])).attr(\"height\", d => y(d[0]) - y(d[1])).attr(\"width\", x.bandwidth());\n\n      // 添加文字标签\n      svg.selectAll(\".stack-label\").data(data).enter().append(\"text\").attr(\"x\", d => x(d.name) + x.bandwidth() / 2).attr(\"y\", d => y(d3.sum(subgroups, k => d[k])) - 5).attr(\"text-anchor\", \"middle\").attr(\"font-size\", \"13px\").attr(\"fill\", \"#000\").attr(\"font-weight\", \"600\").text(d => formatNumber(d3.sum(subgroups, k => d[k])));\n\n      // 图例\n      const legend = svg.selectAll(\".legend\").data(subgroups).enter().append(\"g\").attr(\"transform\", (d, i) => `translate(${width - 50}, ${i * 16})`);\n      legend.append(\"rect\").attr(\"width\", 10).attr(\"height\", 10).attr(\"fill\", d => color(d));\n      legend.append(\"text\").attr(\"x\", 14).attr(\"y\", 9).attr(\"font-size\", \"13px\").attr(\"fill\", \"#000\").attr(\"font-weight\", \"600\").text(d => d);\n    }\n\n    // 监听 props 变化重新渲染\n    watch(() => props.data, renderChart, {\n      deep: true\n    });\n    onMounted(renderChart);\n    const __returned__ = {\n      props,\n      chartContainer,\n      formatNumber,\n      renderChart,\n      renderPieChart,\n      renderBarChart,\n      renderLineChart,\n      renderStackedChart,\n      get d3() {\n        return d3;\n      },\n      onMounted,\n      ref,\n      watch\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["d3","onMounted","ref","watch","props","__props","chartContainer","formatNumber","value","toFixed","renderChart","container","select","selectAll","remove","type","data","length","append","attr","text","renderPieChart","renderBarChart","renderLineChart","renderStackedChart","width","height","radius","Math","min","color","scaleOrdinal","schemeCategory10","pie","d","arc","outerRadius","innerRadius","svg","style","g","enter","name","centroid","legend","i","margin","top","right","bottom","left","x","scaleBand","range","padding","y","scaleLinear","domain","map","max","bandwidth","scalePoint","line","datum","subgroups","Object","keys","filter","k","groups","sum","stackedData","stack","key","deep"],"sources":["D:/vue_frame/vue_frame/wikitable-vue/client/src/components/compoents_base/SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<!-- GDP Rank 的直接显示 -->\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<!-- 其他文本字段保持原样 -->\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 柱状图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 折线图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 堆叠图 -->\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script setup>\r\n\timport * as d3 from \"d3\";\r\n\timport { onMounted, ref, watch } from \"vue\";\r\n\r\n\t// 传入 props\r\n\tconst props = defineProps({\r\n\t\ttype: String,\r\n\t\tdata: Array,\r\n\t\tunit: String,\r\n\t\ttitle: String\r\n\t});\r\n\r\n\t// D3 容器引用\r\n\tconst chartContainer = ref(null);\r\n\r\n\t// 工具函数：格式化数字\r\n\tfunction formatNumber(value) {\r\n\t\tif (typeof value !== \"number\") return value;\r\n\t\tif (value >= 1e8) return (value / 1e8).toFixed(1) + \"亿\";\r\n\t\tif (value >= 1e4) return (value / 1e4).toFixed(1) + \"万\";\r\n\t\treturn value;\r\n\t}\r\n\r\n\t// 初始化 D3 图表\r\n\tfunction renderChart() {\r\n\t\tif (!chartContainer.value) return;\r\n\t\tconst container = d3.select(chartContainer.value);\r\n\t\tcontainer.selectAll(\"*\").remove();\r\n\r\n\t\tconst { type, data } = props;\r\n\t\tif (!data || data.length === 0) {\r\n\t\t\tcontainer.append(\"div\").attr(\"class\", \"no-data\").text(\"暂无数据\");\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tswitch (type) {\r\n\t\t\tcase \"pie\":\r\n\t\t\t\trenderPieChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"bar\":\r\n\t\t\t\trenderBarChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"line\":\r\n\t\t\t\trenderLineChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"stacked\":\r\n\t\t\t\trenderStackedChart(container, data);\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\t/* ===========================\r\n   饼图\r\n=========================== */\r\n\tfunction renderPieChart(container, data) {\r\n\t\tconst width = 160;\r\n\t\tconst height = 160;\r\n\t\tconst radius = Math.min(width, height) / 2;\r\n\r\n\t\tconst color = d3.scaleOrdinal(d3.schemeCategory10);\r\n\t\tconst pie = d3.pie().value(d => d.value);\r\n\t\tconst arc = d3\r\n\t\t\t.arc()\r\n\t\t\t.outerRadius(radius - 10)\r\n\t\t\t.innerRadius(0);\r\n\r\n\t\tconst svg = container\r\n\t\t\t.append(\"svg\")\r