)) : (_openBlock(), _createElementBlock(\"div\", _hoisted_11, \"-\"))], 64 /* STABLE_FRAGMENT */)) : (_openBlock(), _createElementBlock(_Fragment, {\n    key: 5\n  }, [_createCommentVNode(\" 默认显示 \"), _createElementVNode(\"div\", {\n    class: \"simple-text\",\n    onClick: _cache[3] || (_cache[3] = function () {\n      return $setup.handleTextClick && $setup.handleTextClick(...arguments);\n    }),\n    onMouseenter: _cache[4] || (_cache[4] = function () {\n      return $setup.handleTextHover && $setup.handleTextHover(...arguments);\n    }),\n    onMouseleave: _cache[5] || (_cache[5] = function () {\n      return $setup.resetHover && $setup.resetHover(...arguments);\n    })\n  }, _toDisplayString($setup.formatSimpleText($setup.processedField)), 33 /* TEXT, NEED_HYDRATION */), $setup.isTextHovered ? (_openBlock(), _createElementBlock(\"div\", _hoisted_12, \"点击查看详情\")) : _createCommentVNode(\"v-if\", true)], 64 /* STABLE_FRAGMENT */))]);\n}","map":{"version":3,"names":["class","key","ref","_createElementBlock","_hoisted_1","_createCommentVNode","$props","visualization","_Fragment","fieldKey","_hoisted_2","_toDisplayString","$setup","getRawTextForRank","processedField","_createElementVNode","onClick","_cache","handleTextClick","arguments","onMouseenter","handleTextHover","onMouseleave","resetHover","formatSimpleText","isTextHovered","_hoisted_3","hasData","isValidPieData","_hoisted_4","_hoisted_5","_hoisted_6","_hoisted_7","_hoisted_8","_hoisted_9","_hoisted_10","_hoisted_11","_hoisted_12"],"sources":["D:\\vue_frame\\vue_frame\\wikitable-vue\\client\\src\\components\\compoents_base\\SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<!-- GDP Rank 的直接显示 -->\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<!-- 其他文本字段保持原样 -->\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 柱状图 -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 折线图 -->\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 堆叠图 -->\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\timport { computed, ref, onMounted, watch, nextTick } from \"vue\";\r\n\timport * as d3 from \"d3\";\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\tfield: { type: [Object, Array, String, Number], default: null },\r\n\t\t\ttype: { type: String, default: \"\" },\r\n\t\t\tvisualization: { type: String, default: \"\" },\r\n\t\t\tfieldKey: { type: String, default: \"\" },\r\n\t\t\tunifiedMax: { type: Number, default: null },\r\n\t\t\tcategoryColors: { type: Object, default: () => ({}) }\r\n\t\t},\r\n\r\n\t\temits: [\"chartClick\"],\r\n\r\n\t\tsetup(props, { emit }) {\r\n\t\t\tconst hoveredIndex = ref(null);\r\n\t\t\tconst activeIndex = ref(null);\r\n\t\t\tconst isTextHovered = ref(false);\r\n\r\n\t\t\tconst pieContainer = ref(null);\r\n\t\t\tconst barContainer = ref(null);\r\n\t\t\tconst lineContainer = ref(null);\r\n\t\t\tconst stackedContainer = ref(null);\r\n\r\n\t\t\t/* ===================== 辅助函数 ===================== */\r\n\t\t\tconst isYearEntry = v =>\r\n\t\t\t\ttypeof v === \"string\" && /^\\(\\d{4}/.test(v.trim());\r\n\t\t\tconst safeToNumber = v => {\r\n\t\t\t\tif (v == null) return 0;\r\n\t\t\t\tif (typeof v === \"number\") return v;\r\n\t\t\t\tconst num = parseFloat(String(v).replace(/[^\\d.-]/g, \"\"));\r\n\t\t\t\treturn isNaN(num) ? 0 : num;\r\n\t\t\t};\r\n\r\n\t\t\tconst processedField = computed(() => {\r\n\t\t\t\tconst field = props.field;\r\n\t\t\t\tif (!field || (Array.isArray(field) && field.length === 0)) return [];\r\n\t\t\t\tconst fieldArr = Array.isArray(field) ? field : [field];\r\n\t\t\t\treturn fieldArr\r\n\t\t\t\t\t.map(item =>\r\n\t\t\t\t\t\ttypeof item === \"object\" && item !== null\r\n\t\t\t\t\t\t\t? {\r\n\t\t\t\t\t\t\t\t\traw: item.raw ?? item.value ?? JSON.stringify(item),\r\n\t\t\t\t\t\t\t\t\tvalue: item.value ?? item.raw,\r\n\t\t\t\t\t\t\t\t\tlabel: item.label || item.raw\r\n\t\t\t\t\t\t\t  }\r\n\t\t\t\t\t\t\t: { raw: String(item), value: item, label: String(item) }\r\n\t\t\t\t\t)\r\n\t\t\t\t\t.filter(\r\n\t\t\t\t\t\tit => it.raw && String(it.raw).trim() !== \"\" && !isYearEntry(it.raw)\r\n\t\t\t\t\t);\r\n\t\t\t});\r\n\r\n\t\t\tconst getRawTextForRank = field =>\r\n\t\t\t\t!field || field.length === 0 ? \"-\" : field.map(f => f.raw).join(\"\\n\");\r\n\r\n\t\t\t/* ===================== 格式化函数 ===================== */\r\n\t\t\tconst formatSimpleText = val => {\r\n\t\t\t\tif (!val || val.length === 0) return \"-\";\r\n\t\t\t\tconst arr = val.map(v => v.raw || v.value);\r\n\t\t\t\treturn arr.length > 3\r\n\t\t\t\t\t? arr.slice(0, 3).join(\"; \") + \"...\"\r\n\t\t\t\t\t: arr.join(\"; \");\r\n\t\t\t};\r\n\t\t\tconst formatNumber = n => {\r\n\t\t\t\tconst num = Number(n);\r\n\t\t\t\tif (isNaN(num)) return \"0\";\r\n\t\t\t\tif (props.type === \"percentage\") return num.toFixed(1) + \"%\";\r\n\t\t\t\tif (num >= 1e8) return (num / 1e8).toFixed(1) + \"亿\";\r\n\t\t\t\tif (num >= 1e4) return (num / 1e4).toFixed(1) + \"万\";\r\n\t\t\t\treturn num.toFixed(1);\r\n\t\t\t};\r\n\r\n\t\t\t/* ===================== 数据源 ===================== */\r\n\t\t\tconst pieData = computed(() =>\r\n\t\t\t\t(processedField.value || [])\r\n\t\t\t\t\t.map((it, i) => ({\r\n\t\t\t\t\t\tvalue: safeToNumber(it.value),\r\n\t\t\t\t\t\tname: String(it.label || it.raw),\r\n\t\t\t\t\t\tindex: i\r\n\t\t\t\t\t}))\r\n\t\t\t\t\t.filter(d => d.value > 0)\r\n\t\t\t);\r\n\t\t\tconst isValidPieData = computed(() => pieData.value.length > 0);\r\n\t\t\tconst hasData = computed(() => processedField.value.length > 0);\r\n\r\n\t\t\t/* ===================== 渲染逻辑 ===================== */\r\n\t\t\tconst renderPieChart = () => {\r\n\t\t\t\tif (!pieContainer.value) return;\r\n\t\t\t\td3.select(pieContainer.value).selectAll(\"*\").remove();\r\n\t\t\t\tconst container = d3.select(pieContainer.value);\r\n\t\t\t\tconst width = pieContainer.value.clientWidth;\r\n\t\t\t\tconst height = pieContainer.value.clientHeight;\r\n\t\t\t\tconst radius = Math.min(width, height) / 2 - 10;\r\n\r\n\t\t\t\tconst svg = container\r\n\t\t\t\t\t.append(\"svg\")\r\n\t\t\t\t\t.attr(\"width\", width)\r\n\t\t\t\t\t.attr(\"height\", height)\r\n\t\t\t\t\t.append(\"g\")\r\n\t\t\t\t\t.attr(\"transform\", `translate(${width / 2}, ${height / 2})`);\r\n\r\n\t\t\t\tconst color = d3.scaleOrdinal(d3.schemeTableau10);\r\n\t\t\t\tconst pie = d3.pie().value(d => d.value);\r\n\t\t\t\tconst arc = d3.arc().innerRadius(0).outerRadius(radius);\r\n\r\n\t\t\t\tconst arcs = svg\r\n\t\t\t\t\t.selectAll(\"arc\")\r\n\t\t\t\t\t.data(pie(pieData.value))\r\n\t\t\t\t\t.enter()\r\n\t\t\t\t\t.append(\"g\");\r\n\r\n\t\t\t\tarcs\r\n\t\t\t\t\t.append(\"path\")\r\n\t\t\t\t\t.attr(\"d\", arc)\r\n\t\t\t\t\t.attr(\"fill\", (d, i) => color(i))\r\n\t\t\t\t\t.style(\"stroke\", \"#fff\")\r\n\t\t\t\t\t.style(\"stroke-width\", \"1px\");\r\n\r\n\t\t\t\t// 修改字体大小 & 颜色\r\n\t\t\t\tarcs\r\n\t\t\t\t\t.append(\"text\")\r\n\t\t\t\t\t.attr(\"transform\", d => `translate(${arc.centroid(d)})`)\r\n\t\t\t\t\t.attr(\"text-anchor\", \"middle\")\r\n\t\t\t\t\t.attr(\"font-size\", \"16px\")\r\n\t\t\t\t\t.attr(\"fill\", \"#000\")\r\n\t\t\t\t\t.text(d => `${d.data.name}`);\r\n\t\t\t};\r\n\r\n\t\t\tconst renderBarChart = () => {\r\n\t\t\t\tif (!barContainer.value) return;\r\n\t\t\t\td3.select(barContainer.value).selectAll(\"*\").remove();\r\n\t\t\t\tconst container = d3.select(barContainer.value);\r\n\t\t\t\tconst width = barContainer.value.clientWidth;\r\n\t\t\t\tconst height = barContainer.value.clientHeight;\r\n\t\t\t\tconst svg = container\r\n\t\t\t\t\t.append(\"svg\")\r\n\t\t\t\t\t.attr(\"width\", width)\r\n\t\t\t\t\t.attr(\"height\", height);\r\n\t\t\t\tconst data = pieData.value;\r\n\t\t\t\tconst x = d3\r\n\t\t\t\t\t.scaleBand()\r\n\t\t\t\t\t.domain(data.map(d => d.name))\r\n\t\t\t\t\t.range([40, width - 20])\r\n\t\t\t\t\t.padding(0.2);\r\n\t\t\t\tconst y = d3\r\n\t\t\t\t\t.scaleLinear()\r\n\t\t\t\t\t.domain([0, d3.max(data, d => d.value)])\r\n\t\t\t\t\t.range([height - 30, 10]);\r\n\t\t\t\tsvg\r\n\t\t\t\t\t.selectAll(\"rect\")\r\n\t\t\t\t\t.data(data)\r\n\t\t\t\t\t.enter()\r\n\t\t\t\t\t.append(\"rect\")\r\n\t\t\t\t\t.attr(\"x\", d => x(d.name))\r\n\t\t\t\t\t.attr(\"y\", d => y(d.value))\r\n\t\t\t\t\t.attr(\"width\", x.bandwidth())\r\n\t\t\t\t\t.attr(\"height\", d => height - 30 - y(d.value))\r\n\t\t\t\t\t.attr(\"fill\", \"#3498db\");\r\n\t\t\t\tsvg\r\n\t\t\t\t\t.selectAll(\"text\")\r\n\t\t\t\t\t.data(data)\r\n\t\t\t\t\t.enter()\r\n\t\t\t\t\t.append(\"text\")\r\n\t\t\t\t\t.attr(\"x\", d => x(d.name) + x.bandwidth() / 2)\r\n\t\t\t\t\t.attr(\"y\", d => y(d.value) - 5)\r\n\t\t\t\t\t.attr(\"text-anchor\", \"middle\")\r\n\t\t\t\t\t.attr(\"font-size\", \"16px\")\r\n\t\t\t\t\t.attr(\"fill\", \"#000\")\r\n\t\t\t\t\t.text(d => d.value);\r\n\t\t\t};\r\n\r\n\t\t\t/* ===================== 监听更新 ===================== */\r\n\t\t\tonMounted(() => {\r\n\t\t\t\twatch(\r\n\t\t\t\t\t() => [processedField.value, props.visualization],\r\n\t\t\t\t\t() => {\r\n\t\t\t\t\t\tnextTick(() => {\r\n\t\t\t\t\t\t\tif (props.visualization === \"pie-chart\" && hasData.value)\r\n\t\t\t\t\t\t\t\trenderPieChart();\r\n\t\t\t\t\t\t\tif (props.visualization === \"bar-chart\" && hasData.value)\r\n\t\t\t\t\t\t\t\trenderBarChart();\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t},\r\n\t\t\t\t\t{ immediate: true, deep: true }\r\n\t\t\t\t);\r\n\t\t\t});\r\n\r\n\t\t\tconst handleTextHover = () => (isTextHovered.value = true);\r\n\t\t\tconst resetHover = () => (isTextHovered.value = false);\r\n\t\t\tconst handleTextClick = () =>\r\n\t\t\t\temit(\"chartClick\", { type: \"text\", data: processedField.value });\r\n\r\n\t\t\treturn {\r\n\t\t\t\tisTextHovered,\r\n\t\t\t\thandleTextHover,\r\n\t\t\t\tresetHover,\r\n\t\t\t\thandleTextClick,\r\n\t\t\t\tformatSimpleText,\r\n\t\t\t\tgetRawTextForRank,\r\n\t\t\t\tprocessedField,\r\n\t\t\t\thasData,\r\n\t\t\t\tisValidPieData,\r\n\t\t\t\tpieContainer,\r\n\t\t\t\tbarContainer\r\n\t\t\t};\r\n\t\t}\r\n\t};\r\n</script>\r\n\r\n<style scoped>\r\n\t.simple-chart {\r\n\t\twidth: 100%;\r\n\t\theight: 100%;\r\n\t\tdisplay: flex;\r\n\t\talign-items: center;\r\n\t\tjustify-content: center;\r\n\t\tposition: relative;\r\n\t\tfont-family: \"Segoe UI\", Arial, sans-serif;\r\n\t\tcolor: #000;\r\n\t\t-webkit-font-smoothing: antialiased;\r\n\t\t-moz-osx-font-