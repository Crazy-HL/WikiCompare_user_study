{"ast":null,"code":"import { computed, ref, onMounted, watch, nextTick } from \"vue\";\nimport * as d3 from \"d3\";\nexport default {\n  props: {\n    // ... props 保持不变\n    field: {\n      type: [Object, Array, String, Number],\n      default: null\n    },\n    type: {\n      type: String,\n      default: \"\"\n    },\n    visualization: {\n      type: String,\n      default: \"\"\n    },\n    fieldKey: {\n      type: String,\n      default: \"\"\n    },\n    unifiedMax: {\n      type: Number,\n      default: null\n    },\n    categoryColors: {\n      type: Object,\n      default: () => ({})\n    }\n  },\n  emits: [\"chartClick\"],\n  setup(props, _ref) {\n    let {\n      emit\n    } = _ref;\n    // ... setup 中的大部分逻辑保持不变\n    const hoveredIndex = ref(null);\n    const activeIndex = ref(null);\n    const isTextHovered = ref(false);\n    const pieContainer = ref(null);\n    const barContainer = ref(null);\n    const lineContainer = ref(null);\n    const stackedContainer = ref(null);\n    const colors = [\"#3498db\", \"#e74c3c\", \"#2ecc71\", \"#f39c12\", \"#9b59b6\"];\n    const remainderColor = \"#f0f0f0\";\n    const isYearEntry = value => {\n      if (typeof value !== \"string\") return false;\n      const trimmedValue = value.trim();\n      return /^\\(\\d{4}\\)$/.test(trimmedValue);\n    };\n    const safeToNumber = value => {\n      if (value === null || value === undefined) return 0;\n      if (typeof value === \"number\") return value;\n      if (typeof value === \"string\") {\n        if (value.includes(\"亿\")) return parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 100000000;\n        if (value.includes(\"万\")) return parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 10000;\n        if (value.includes(\"千\")) return parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 1000;\n        const num = parseFloat(value.replace(/[^\\d,.-]/g, \"\"));\n        return isNaN(num) ? 0 : num;\n      }\n      if (typeof value === \"object\") return safeToNumber(value.value || value.raw);\n      return 0;\n    };\n    const processedField = computed(() => {\n      const field = props.field;\n      if (!field || Array.isArray(field) && field.length === 0) return [];\n      const fieldAsArray = Array.isArray(field) ? field : [field];\n      return fieldAsArray.map(item => {\n        if (typeof item === \"object\" && item !== null) {\n          return {\n            raw: item.raw ?? item.value ?? JSON.stringify(item),\n            value: item.value ?? item.raw,\n            label: item.label || item.raw,\n            parent: item.parent || null\n          };\n        }\n        return {\n          raw: String(item),\n          value: item,\n          label: String(item),\n          parent: null\n        };\n      }).filter(item => item.raw && String(item.raw).trim() !== \"\" && !isYearEntry(String(item.raw)));\n    });\n    const getRawTextForRank = field => {\n      if (!field || field.length === 0) return \"-\";\n      return field.map(item => item.raw).join(\"\\n\");\n    };\n    onMounted(() => {\n      watch(() => [processedField.value, props.visualization, props.unifiedMax], () => {\n        nextTick(() => {\n          if (props.visualization === \"pie-chart\" && hasData.value && isValidPieData.value) {\n            renderPieChartWithLegend(); // 调用更新后的函数\n          }\n          // ... 其他图表渲染调用保持不变\n        });\n      }, {\n        immediate: true,\n        deep: true\n      });\n    });\n\n    // ====================================================================\n    // ========================= 饼图渲染函数（已重构） =========================\n    // ====================================================================\n    const renderPieChartWithLegend = () => {\n      // 1. 【初始化和清理】\n      if (!pieContainer.value) return;\n      const container = d3.select(pieContainer.value);\n      container.selectAll(\"*\").remove(); // 清空所有内容\n\n      // 2. 【设置布局】\n      const totalWidth = container.node().clientWidth;\n      const totalHeight = container.node().clientHeight;\n\n      // 将容器分为图表区和图注区\n      const chartArea = container.append(\"div\").attr(\"class\", \"pie-chart-area\");\n      const legendArea = container.append(\"div\").attr(\"class\", \"pie-legend-area\");\n\n      // 3. 【绘制饼图本身】\n      const chartWidth = chartArea.node().clientWidth;\n      const chartHeight = totalHeight;\n      const radius = Math.min(chartWidth, chartHeight) / 2 * 0.9;\n      const svg = chartArea.append(\"svg\").attr(\"width\", \"100%\").attr(\"height\", \"100%\").attr(\"viewBox\", `0 0 ${chartWidth} ${chartHeight}`).append(\"g\").attr(\"transform\", `translate(${chartWidth / 2}, ${chartHeight / 2})`);\n      const isSingleValue = props.fieldKey === \"Inflation (CPI)\";\n      const chartData = isSingleValue && pieData.value.length > 0 ? [{\n        ...pieData.value[0],\n        color: colors[0]\n      }, {\n        value: Math.max(0, 100 - pieData.value[0].value),\n        name: \"剩余\",\n        color: remainderColor,\n        isRemainder: true\n      }] : pieData.value.map((d, i) => ({\n        ...d,\n        color: colors[i % colors.length]\n      }));\n      const pie = d3.pie().value(d => d.value).sort(null);\n      const arc = d3.arc().innerRadius(0).outerRadius(radius);\n\n      // Tooltip\n      const tooltip = container.append(\"div\").attr(\"class\", \"d3-tooltip\").style(\"position\", \"absolute\").style(\"visibility\", \"hidden\");\n\n      // 绘制扇区\n      svg.selectAll(\".arc\").data(pie(chartData)).enter().append(\"path\").attr(\"d\", arc).attr(\"fill\", d => d.data.color).style(\"opacity\", 0.8).style(\"stroke\", \"#fff\").style(\"stroke-width\", 1).on(\"mouseover\", function (event, d) {\n        if (d.data.isRemainder) return;\n        d3.select(this).transition().duration(200).style(\"opacity\", 1);\n        tooltip.style(\"visibility\", \"visible\").html(`${d.data.name}: ${d.data.value.toFixed(1)}%`);\n      }).on(\"mousemove\", event => tooltip.style(\"top\", `${event.pageY - 10}px`).style(\"left\", `${event.pageX + 10}px`)).on(\"mouseout\", function (event, d) {\n        if (d.data.isRemainder) return;\n        d3.select(this).transition().duration(200).style(\"opacity\", 0.8);\n        tooltip.style(\"visibility\", \"hidden\");\n      }).on(\"click\", (event, d) => {\n        if (d.data.isRemainder) return;\n        emit(\"chartClick\", {\n          type: \"pie\",\n          ...d.data\n        });\n      });\n\n      // 在中心显示文本\n      if (isSingleValue && pieData.value.length > 0) {\n        svg.append(\"text\").attr(\"text-anchor\", \"middle\").attr(\"dy\", \".3em\").text(`${pieData.value[0].value.toFixed(1)}%`).style(\"font-size\", \"14px\").style(\"fill\", \"#333\");\n      }\n\n      // 4. 【绘制图注】\n      const legendData = pieData.value; // 使用原始数据进行图注\n      const legendItems = legendArea.selectAll(\".legend-item\").data(legendData).enter().append(\"div\").attr(\"class\", \"legend-item\");\n\n      // 图注颜色块\n      legendItems.append(\"div\").attr(\"class\", \"legend-color-swatch\").style(\"background-color\", (d, i) => colors[i % colors.length]);\n\n      // 图注文本\n      legendItems.append(\"span\").attr(\"class\", \"legend-label\").text(d => `${d.name}: ${d.value.toFixed(1)}%`);\n    };\n\n    // ... 其他函数保持不变\n\n    const hasData = computed(() => processedField.value && processedField.value.length > 0);\n    const isValidPieData = computed(() => pieData.value.length > 0);\n    const pieData = computed(() => {\n      if (!processedField.value) return [];\n      return processedField.value.map((item, index) => {\n        let rawValue = item.raw || item.value || item;\n        if (isYearEntry(String(rawValue))) return null;\n        const value = safeToNumber(rawValue);\n        if (value === 0 && isNaN(parseFloat(rawValue))) return null;\n        let name = String(rawValue).replace(/:\\s*\\d+\\.?\\d*%?/g, \"\").trim();\n        if (isYearEntry(name)) return null;\n        return {\n          value: Math.min(100, Math.max(0, value)),\n          name: name || \"项目\",\n          index\n        };\n      }).filter(Boolean);\n    });\n    return {\n      // ... return 的内容保持不变\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","watch","nextTick","d3","props","field","type","Object","Array","String","Number","default","visualization","fieldKey","unifiedMax","categoryColors","emits","setup","_ref","emit","hoveredIndex","activeIndex","isTextHovered","pieContainer","barContainer","lineContainer","stackedContainer","colors","remainderColor","isYearEntry","value","trimmedValue","trim","test","safeToNumber","undefined","includes","parseFloat","replace","num","isNaN","raw","processedField","isArray","length","fieldAsArray","map","item","JSON","stringify","label","parent","filter","getRawTextForRank","join","hasData","isValidPieData","renderPieChartWithLegend","immediate","deep","container","select","selectAll","remove","totalWidth","node","clientWidth","totalHeight","clientHeight","chartArea","append","attr","legendArea","chartWidth","chartHeight","radius","Math","min","svg","isSingleValue","chartData","pieData","color","max","name","isRemainder","d","i","pie","sort","arc","innerRadius","outerRadius","tooltip","style","data","enter","on","event","transition","duration","html","toFixed","pageY","pageX","text","legendData","legendItems","index","rawValue","Boolean"],"sources":["D:\\vue_frame\\vue_frame\\wikitable-vue\\client\\src\\components\\compoents_base\\SimpleChart.vue"],"sourcesContent":["<template>\r\n\t<div class=\"simple-chart\">\r\n\t\t<!-- 文本显示 -->\r\n\t\t<template v-if=\"visualization === 'text-only'\">\r\n\t\t\t<!-- GDP Rank 的直接显示 -->\r\n\t\t\t<div v-if=\"fieldKey === 'GDP rank'\" class=\"gdp-rank-direct-display\">\r\n\t\t\t\t{{ getRawTextForRank(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<!-- 其他文本字段保持原样 -->\r\n\t\t\t<div\r\n\t\t\t\tv-else\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered && fieldKey !== 'GDP rank'\" class=\"text-tooltip\">\r\n\t\t\t\t点击查看详情\r\n\t\t\t</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 饼图 (D3实现) -->\r\n\t\t<template v-else-if=\"visualization === 'pie-chart'\">\r\n\t\t\t<!-- 这个容器现在是图表和图注的父容器 -->\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData && isValidPieData\"\r\n\t\t\t\tclass=\"d3-chart-container pie-layout-container\"\r\n\t\t\t\tref=\"pieContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 其他图表... -->\r\n\t\t<template v-else-if=\"visualization === 'bar-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"barContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<template v-else-if=\"visualization === 'line-chart'\">\r\n\t\t\t<div v-if=\"hasData\" class=\"d3-chart-container\" ref=\"lineContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<template v-else-if=\"visualization === 'stacked-chart'\">\r\n\t\t\t<div\r\n\t\t\t\tv-if=\"hasData\"\r\n\t\t\t\tclass=\"d3-chart-container\"\r\n\t\t\t\tref=\"stackedContainer\"></div>\r\n\t\t\t<div v-else class=\"no-data\">-</div>\r\n\t\t</template>\r\n\r\n\t\t<!-- 默认显示 -->\r\n\t\t<template v-else>\r\n\t\t\t<div\r\n\t\t\t\tclass=\"simple-text\"\r\n\t\t\t\t@click=\"handleTextClick\"\r\n\t\t\t\t@mouseenter=\"handleTextHover\"\r\n\t\t\t\t@mouseleave=\"resetHover\">\r\n\t\t\t\t{{ formatSimpleText(processedField) }}\r\n\t\t\t</div>\r\n\t\t\t<div v-if=\"isTextHovered\" class=\"text-tooltip\">点击查看详情</div>\r\n\t\t</template>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\n\timport { computed, ref, onMounted, watch, nextTick } from \"vue\";\r\n\timport * as d3 from \"d3\";\r\n\r\n\texport default {\r\n\t\tprops: {\r\n\t\t\t// ... props 保持不变\r\n\t\t\tfield: {\r\n\t\t\t\ttype: [Object, Array, String, Number],\r\n\t\t\t\tdefault: null\r\n\t\t\t},\r\n\t\t\ttype: {\r\n\t\t\t\ttype: String,\r\n\t\t\t\tdefault: \"\"\r\n\t\t\t},\r\n\t\t\tvisualization: {\r\n\t\t\t\ttype: String,\r\n\t\t\t\tdefault: \"\"\r\n\t\t\t},\r\n\t\t\tfieldKey: {\r\n\t\t\t\ttype: String,\r\n\t\t\t\tdefault: \"\"\r\n\t\t\t},\r\n\t\t\tunifiedMax: {\r\n\t\t\t\ttype: Number,\r\n\t\t\t\tdefault: null\r\n\t\t\t},\r\n\t\t\tcategoryColors: {\r\n\t\t\t\ttype: Object,\r\n\t\t\t\tdefault: () => ({})\r\n\t\t\t}\r\n\t\t},\r\n\r\n\t\temits: [\"chartClick\"],\r\n\r\n\t\tsetup(props, { emit }) {\r\n\t\t\t// ... setup 中的大部分逻辑保持不变\r\n\t\t\tconst hoveredIndex = ref(null);\r\n\t\t\tconst activeIndex = ref(null);\r\n\t\t\tconst isTextHovered = ref(false);\r\n\r\n\t\t\tconst pieContainer = ref(null);\r\n\t\t\tconst barContainer = ref(null);\r\n\t\t\tconst lineContainer = ref(null);\r\n\t\t\tconst stackedContainer = ref(null);\r\n\r\n\t\t\tconst colors = [\"#3498db\", \"#e74c3c\", \"#2ecc71\", \"#f39c12\", \"#9b59b6\"];\r\n\t\t\tconst remainderColor = \"#f0f0f0\";\r\n\r\n\t\t\tconst isYearEntry = value => {\r\n\t\t\t\tif (typeof value !== \"string\") return false;\r\n\t\t\t\tconst trimmedValue = value.trim();\r\n\t\t\t\treturn /^\\(\\d{4}\\)$/.test(trimmedValue);\r\n\t\t\t};\r\n\r\n\t\t\tconst safeToNumber = value => {\r\n\t\t\t\tif (value === null || value === undefined) return 0;\r\n\t\t\t\tif (typeof value === \"number\") return value;\r\n\t\t\t\tif (typeof value === \"string\") {\r\n\t\t\t\t\tif (value.includes(\"亿\"))\r\n\t\t\t\t\t\treturn parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 100000000;\r\n\t\t\t\t\tif (value.includes(\"万\"))\r\n\t\t\t\t\t\treturn parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 10000;\r\n\t\t\t\t\tif (value.includes(\"千\"))\r\n\t\t\t\t\t\treturn parseFloat(value.replace(/[^\\d.-]/g, \"\")) * 1000;\r\n\t\t\t\t\tconst num = parseFloat(value.replace(/[^\\d,.-]/g, \"\"));\r\n\t\t\t\t\treturn isNaN(num) ? 0 : num;\r\n\t\t\t\t}\r\n\t\t\t\tif (typeof value === \"object\")\r\n\t\t\t\t\treturn safeToNumber(value.value || value.raw);\r\n\t\t\t\treturn 0;\r\n\t\t\t};\r\n\r\n\t